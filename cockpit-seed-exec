#!/usr/bin/env bash
# cockpit-seed-exec — the in-pane launcher for a SEEDED spawn (cockpit-spawn --request-id …).
#
#   cockpit-seed-exec <record.json> <staging-prompt-file> <name> <cwd> [provider-bin] [human|agent] [orb-file] [claude|codex]
#
# Runs INSIDE the freshly-created tmux pane. It binds this pane to the durable seed request (closing the
# crash window between split-window and the spawner's own record update — $TMUX_PANE is authoritative here),
# stamps the pending seed metadata onto the pane BEFORE the provider can emit any lifecycle event, reads and
# re-validates the exact prompt bytes from the producer-owned protected staging file, unlinks it, and then
# directly execs an argv array:  <provider> [provider args] -- <exact prompt>.
#
# PROVIDER ($8, cross-checked against the durable record; omitted → claude, which every pre-provider caller
# meant). `claude` execs the pre-provider argv byte-for-byte. `codex` execs the prompt as Codex's positional
# prompt with ONE per-invocation config override — the launch cwd's trust level — because Codex gates startup
# on a folder-trust dialog that an agent-driven pane has nobody to answer. Nothing else is overridden: the
# operator's own approval_policy and sandbox_mode govern the session exactly as they do a hand-started Codex,
# and ~/.codex/config.toml is never written. Codex has no app-side remote control, so no --remote-control is
# passed, and no hook, so its seed has no acceptance event — the record honestly stays `pending`.
#
# The prompt is DATA only: it is never interpolated into a shell command, never passed through tmux
# send-keys/paste buffers, and never written to the durable record, pane options, stdout/stderr, or logs.
# Any failure before exec marks the still-pending request failed with a bounded, content-free code.
#
# INTERACTION PROFILE ($6, typed, validated, cross-checked against the durable record): `human` (the default,
# and every pre-profile launch) execs exactly the pre-profile argv. `agent` marks the session as driven by
# another AI agent: it sets AGENT_DRIVEN=1 in the provider environment and appends ONLY
#   --permission-mode bypassPermissions
#   --settings '{"skipDangerousModePermissionPrompt":true}'
#   --disallowedTools AskUserQuestion EnterPlanMode
#   --append-system-prompt <agent system text below>
# to this one invocation's argv. Global Claude settings are never read or modified; non-seeded and human
# launches carry none of these flags. The inline --settings object accompanies the owner-required
# bypassPermissions mode because Claude 2.1.217 gates the Bypass Permissions acknowledgement dialog on
# flagSettings.skipDangerousModePermissionPrompt (hV()); the dialog persists that key to USER settings only
# after a human accepts it, so a fresh agent-driven launch would otherwise stall on a dialog no agent
# counterpart can dismiss. Passing it as an inline per-invocation flag setting suppresses the dialog for
# THIS launch only — ~/.claude/settings.json is never written.
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"; source "$HERE/lib.sh"

# Agent-profile system text (owner brief, RELEASE-AMEND-001): communicates that the counterpart is another
# agent and how to behave. Passed as ONE argv element to --append-system-prompt — never shell-interpolated.
AGENT_SYSTEM_TEXT='Your counterpart is another AI agent, not a human. Treat the supplied brief as complete and as a scope ceiling. Do not use option menus, enter plan mode, or ask non-blocking clarifying questions. State reasonable assumptions and proceed. When a material decision prevents safe progress, respond `BLOCKED: <reason>` with one recommended resolution and reasoning. Return concise milestone and final evidence; omit pleasantries and routine progress narration.'

record="${1:-}"; staging="${2:-}"; name="${3:-}"; cwd="${4:-}"; provider_bin="${5:-claude}"; profile="${6:-human}"; orb_file="${7:-}"
provider="${8:-claude}"

die() { echo "cockpit-seed-exec: $1" >&2; exit 3; }
# Mark the request failed (only while still pending) with a bounded code, then die. Prompt-free by design.
fail() {
  cockpit_seed_update "$record" \
    'if .status=="pending" then .status="failed" | .error_code=$c else . end' --arg c "$1" >/dev/null 2>&1 || true
  [[ -n "${TMUX_PANE:-}" ]] && tmux set -p -t "$TMUX_PANE" @seed_status failed 2>/dev/null || true
  die "$1"
}

[[ -n "$record" && -n "$staging" && -n "$cwd" ]] || die "usage: cockpit-seed-exec <record> <staging> <name> <cwd> [provider-bin] [human|agent|brief-studio] [orb-server-file] [claude|codex]"
case "$profile" in human|agent|brief-studio) ;; *) die "interaction profile must be 'human', 'agent' or 'brief-studio'";; esac
case "$provider" in claude|codex) ;; *) die "provider must be 'claude' or 'codex'";; esac
# The two non-default profiles are built entirely from Claude-only argv. cockpit-spawn refuses the combination
# before reserving; this is the launcher-side restatement, so a hand-run pane cannot silently drop the flags.
[[ "$provider" == claude || "$profile" == human ]] || die "a codex launch supports the 'human' profile only"
[[ -n "${TMUX_PANE:-}" ]] || die "not inside a tmux pane"
[[ -f "$record" && ! -L "$record" ]] || die "seed record is unavailable or unsafe"

# Bind this pane to the request under the record lock: first pane in wins; a different already-bound pane
# means a duplicate launch attempt and this pane must NOT start a provider or touch the seed.
json=$(cockpit_seed_update "$record" \
  'if .pane_id=="" or .pane_id==$p then .pane_id=$p else . end' --arg p "$TMUX_PANE") || die "seed record update failed"
[[ "$(jq -r .pane_id <<<"$json")" == "$TMUX_PANE" ]] || die "seed request is bound to another pane"
[[ "$(jq -r .status <<<"$json")" == "pending" ]] || die "seed request is not pending"
expect_sha=$(jq -r .sha256 <<<"$json"); expect_bytes=$(jq -r .bytes <<<"$json"); request_id=$(jq -r .request_id <<<"$json")
# The argv profile must be the SAME profile the request was durably reserved with (a pre-profile record
# means human). A disagreement is identity drift — fail bounded, never launch under the wrong profile.
[[ "$(jq -r '.profile // "human"' <<<"$json")" == "$profile" ]] || fail "interaction-profile-drift"
# Same rule for the provider: the pane must start the agent the request was reserved for, never the other one.
[[ "$(jq -r '.provider // "claude"' <<<"$json")" == "$provider" ]] || fail "provider-drift"

# Pending seed metadata is on the pane BEFORE the provider starts, so the very first hook event can already
# see which request this pane serves. Acceptance is NEVER granted here — only the UserPromptSubmit hook may
# move pending → accepted, and only on exact digest/byte match.
tmux set -p -t "$TMUX_PANE" @seed_request_id "$request_id" 2>/dev/null || true
tmux set -p -t "$TMUX_PANE" @seed_status pending 2>/dev/null || true

# Re-validate the protected staging file at the moment of use (untrusted despite being producer-created).
[[ -e "$staging" ]] || fail "prompt-material-unavailable"
[[ ! -L "$staging" && -f "$staging" ]] || fail "prompt-material-unavailable"
actual_sha=$(sha256sum < "$staging" | cut -d' ' -f1)
actual_bytes=$(wc -c < "$staging")
[[ "$actual_sha" == "$expect_sha" ]] || fail "prompt-material-drift"
[[ "$actual_bytes" -eq "$expect_bytes" ]] || fail "prompt-material-drift"

# Materialize the EXACT bytes as one argv element. `read -rd ''` preserves interior and trailing newlines;
# NUL bytes are impossible (validated at spawn). Verify the materialized byte count before trusting it.
prompt=""
IFS= read -rd '' prompt < "$staging" || true
[[ "$(printf '%s' "$prompt" | wc -c)" -eq "$expect_bytes" ]] || fail "prompt-materialization-drift"
rm -f "$staging" 2>/dev/null || true

cd "$cwd" || fail "cwd-unavailable"
# Codex: the prompt is its positional argument, preceded by the one startup-trust override. No remote-control
# (Codex has none) and no profile argv (none of it is Codex's). Nothing else about the session is overridden.
if [[ "$provider" == codex ]]; then
  trust=$(cockpit_codex_trust_value "$cwd") || fail "codex-trust-unassertable"
  exec "$provider_bin" -c "$trust" -- "$prompt"
fi
args=()
# Seeded spawns are always remote-controlled (cockpit-spawn forces RC on); same 48-char app-title bound as
# cockpit_rc_args, but built as a real argv array — no shell hop exists between here and the provider.
[[ "${COCKPIT_REMOTE_CONTROL:-1}" == 1 ]] && args+=(--remote-control "${name:0:48}")
# Agent profile ONLY: per-invocation argv/env delta (see header). `human` adds nothing — byte-identical to
# the pre-profile launch.
if [[ "$profile" == agent ]]; then
  export AGENT_DRIVEN=1
  args+=(--permission-mode bypassPermissions)
  args+=(--settings '{"skipDangerousModePermissionPrompt":true}')   # per-invocation dialog suppression (see header)
  args+=(--disallowedTools AskUserQuestion EnterPlanMode)
  args+=(--append-system-prompt "$AGENT_SYSTEM_TEXT")
fi
# Brief-studio profile: the SAME permission posture as `agent` — bypassPermissions with the inline dialog
# suppression, and the interactive option-menu and plan-mode tools disallowed, because a numbered menu is
# answerable only by keystrokes in the pane and this whole channel exists to avoid that. What differs is the
# system text (the brief is being authored, the counterpart is the operator, ambiguity is asked about rather
# than assumed past) and the per-invocation `orb` MCP server that gives it somewhere to ask.
if [[ "$profile" == brief-studio ]]; then
  args+=(--permission-mode bypassPermissions)
  args+=(--settings '{"skipDangerousModePermissionPrompt":true}')   # per-invocation dialog suppression (see header)
  args+=(--disallowedTools AskUserQuestion EnterPlanMode)
  args+=(--append-system-prompt "$COCKPIT_BRIEF_STUDIO_SYSTEM_TEXT")
  orb_spec=$(cockpit_orb_read_spec "$orb_file") || fail "orb-server-unavailable"
  # One validated argv element built from the validated spec — never shell-interpolated, and no global
  # ~/.claude configuration is read or written.
  args+=(--mcp-config "$(jq -cn --argjson s "$orb_spec" '{mcpServers:{orb:$s}}')")
fi
exec "$provider_bin" "${args[@]}" -- "$prompt"
