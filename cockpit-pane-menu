#!/usr/bin/env python3
"""Cockpit's pane menu, with Explorer actions for the filesystem link clicked."""
import argparse
import base64
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import unicodedata
from urllib.parse import unquote, urlsplit

HERE = Path(__file__).resolve().parent
# How many lines a wrapped path may continue onto, in each direction.
WRAP_REACH = 4
# How far up to look for a copy-mode click's row (cockpit's history-limit is 2000).
SNAPSHOT_SEARCH = 2000
# Copy mode's indicator may start with the top line's time or date before its [n/m].
COPY_INDICATOR_LEAD = 24


def hovered_span(line, column):
    # tmux's mouse_word splits on slashes by default. Find the whitespace-delimited
    # token at the clicked cell instead, accounting for wide/combining characters.
    cell = 0
    for index, char in enumerate(line):
        width = 0 if unicodedata.combining(char) else 2 if unicodedata.east_asian_width(char) in ('W', 'F') else 1
        if cell <= column < cell + width:
            for match in re.finditer(r'\S+', line):
                if match.start() <= index < match.end():
                    return match.span()
            return None
        cell += width
    return None


def same_row(printed, clicked, scroll, row):
    """Whether a captured line is the clicked one, whose text tmux took from its own view."""
    if printed.rstrip() == clicked.rstrip():
        return True
    # Copy mode draws its position indicator ("11:38:32 [37/40]") over the right end of
    # its top row, and that view is what mouse_line reads. Accept a line that agrees up
    # to the indicator.
    if scroll is None or row != 0:
        return False
    indicator = clicked.rfind(f'[{scroll}/')
    agree = len(os.path.commonprefix([printed, clicked]))
    return agree > 0 and 0 <= indicator - agree <= COPY_INDICATOR_LEAD


def screen_lines(tmux, pane, row, scroll, height, line, reach=WRAP_REACH):
    """The clicked row and its neighbours as printed, and the clicked row's index among them.

    Outside copy mode (scroll is None) the clicked row is row `row` of the screen. In copy
    mode tmux shows a snapshot taken on entry, while capture-pane reads the live screen,
    which may have printed (and dropped from history) more lines since; the clicked row is
    then that many rows further up. Find it by its text, searching up from where it would
    be with no new output. Without a match, use the clicked line alone.
    """
    top = row - (scroll or 0)
    # capture-pane repeats the last row for rows past the bottom, so never ask for them.
    after = max(0, min(reach, height - 1 - top))
    try:
        captured = subprocess.run(
            tmux + ['capture-pane', '-p', '-t', pane, '-S', str(top - SNAPSHOT_SEARCH), '-E', str(top + after)],
            capture_output=True, text=True, check=True).stdout.splitlines()
    except (OSError, subprocess.SubprocessError):
        return [line], 0
    for index in range(len(captured) - 1 - after, -1, -1):
        if same_row(captured[index], line, scroll, row):
            start = max(0, index - reach)
            return captured[start:index + 1 + reach], index - start
    return [line], 0


def wrapped_candidates(lines, row, span, reach=WRAP_REACH):
    """The clicked token, alone and joined with the pieces it was wrapped into, longest first.

    A path too long for the line is continued at the start of the next line, after any
    indentation (the terminal wraps at the pane edge; agents wrap and indent their own text).
    So a piece that ends its line may continue on the next, and a piece that starts its
    line may continue the previous one. The caller keeps the longest join that exists.
    """
    def pieces(step):
        found, index, edge = [], row, True
        while edge and len(found) < reach and 0 <= index + step < len(lines):
            index += step
            tokens = list(re.finditer(r'\S+', lines[index]))
            if not tokens:
                break
            token = tokens[-1] if step < 0 else tokens[0]
            found.append(token.group())
            edge = len(tokens) == 1  # only a line that is all one piece can continue further
        return found

    line = lines[row]
    before = pieces(-1)[::-1] if not line[:span[0]].strip() else []
    after = pieces(1) if not line[span[1]:].strip() else []
    token = line[span[0]:span[1]]
    joins = {''.join(before[len(before) - b:] + [token] + after[:a])
             for b in range(len(before) + 1) for a in range(len(after) + 1)}
    return sorted(joins, key=len, reverse=True)


def filesystem_path(text, cwd):
    """Resolve OSC 8 targets or printed paths; ordinary web links are not files."""
    if not text:
        return None
    if text.lower().startswith('file:'):
        url = urlsplit(text)
        text = unquote(url.path)
        if url.netloc.lower() in ('wsl.localhost', 'wsl$'):
            distro, _, text = text.lstrip('/').partition('/')
            if distro.lower() != os.environ.get('WSL_DISTRO_NAME', '').lower():
                return None
            text = '/' + text
        elif url.netloc and url.netloc.lower() != 'localhost':
            return None
        if re.match(r'^/[a-zA-Z]:/', text):
            text = text[1:]
    elif re.match(r'^[a-zA-Z][\w+.-]*:', text) and not re.match(r'^[a-zA-Z]:[\\/]', text):
        return None
    else:
        text = text.lstrip('"\'`([').rstrip('"\'`')
        if not (text.startswith(('/', '~/', './', '../', '\\\\')) or re.match(r'^[a-zA-Z]:[\\/]', text)):
            return None
    if re.match(r'^[a-zA-Z]:[\\/]', text) or text.startswith('\\\\'):
        text = subprocess.check_output(['wslpath', '-u', text], text=True).rstrip('\r\n')
    path = Path(os.path.expanduser(text))
    if not path.is_absolute():
        path = Path(cwd) / path
    # Prefer the literal filename; only then remove a compiler-style line/column suffix.
    if not path.exists():
        path = Path(re.sub(r':\d+(?::\d+)?$', '', str(path).rstrip('.,;)')))
    return path.absolute() if path.exists() else None


def first_existing(candidates, cwd):
    """The first candidate that names an existing file or directory."""
    for text in candidates:
        try:
            path = filesystem_path(text, cwd)
        except (OSError, ValueError, subprocess.SubprocessError):
            continue  # e.g. wslpath refusing a malformed join; try the next one
        if path is not None:
            return path
    return None


def open_explorer(path):
    windows = subprocess.check_output(['wslpath', '-w', str(path)], text=True).rstrip('\r\n')
    explorer = shutil.which('explorer.exe') or '/mnt/c/Windows/explorer.exe'
    args = [explorer, windows] if path.is_dir() else [explorer, '/select,', windows]
    # Explorer may return 1 after handing the request to its already-running process.
    subprocess.run(args, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def pane_items():
    # Keep these commands in tmux's format language so pane/window state is current.
    return [
        '#{?window_zoomed_flag,Unzoom,Zoom}', 'z', 'resize-pane -Z',
        '#{?#{==:#{window-size},manual},Full width,Half width}', 'w', f'run-shell "{HERE}/cockpit-ws toggle #{{window_id}}"',
        'Kill (undoable)', 'k', f'confirm-before -p "kill pane #{{pane_index}}? (y/n)" "run-shell \\"{HERE}/cockpit-pane remove\\""',
        'Restart', 'r', f'confirm-before -p "restart pane #{{pane_index}}? (y/n)" "run-shell \\"{HERE}/cockpit-restart \'#{{pane_id}}\'\\""',
        'Move to next ws', 'm', f'run-shell "{HERE}/cockpit-move next"',
        'Swap up', 'u', 'swap-pane -U',
        'Swap down', 'd', 'swap-pane -D',
    ]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--socket', required=True)
    parser.add_argument('--client', required=True)
    parser.add_argument('--pane')
    parser.add_argument('--link', default='')
    parser.add_argument('--word', default='')
    parser.add_argument('--line', default='')
    parser.add_argument('--left', type=int, default=0)
    parser.add_argument('--top', type=int, default=0)
    parser.add_argument('--cwd', default=os.getcwd())
    parser.add_argument('--x', type=int, default=0)
    parser.add_argument('--y', type=int, default=0)
    parser.add_argument('--height', type=int, default=0)
    # copy mode's scroll_position; empty outside copy mode.
    parser.add_argument('--scroll', type=lambda value: int(value) if value else None, default=None)
    parser.add_argument('--open', dest='encoded_path')
    args = parser.parse_args()
    tmux = ['tmux', '-S', args.socket]
    try:
        if args.encoded_path:
            path = Path(os.fsdecode(base64.urlsafe_b64decode(args.encoded_path)))
            if not path.exists():
                raise ValueError('The file or directory no longer exists')
            open_explorer(path)
            return
        # mouse_x/y are relative to the pane. Use that column for its text,
        # and add the pane's origin only when placing the menu on the screen.
        # An explicit hyperlink wins even when its label resembles a local path.
        if args.link:
            candidates = [args.link]
        elif not args.line:
            candidates = [args.word]
        else:
            lines, row = screen_lines(tmux, args.pane, args.y, args.scroll, args.height, args.line)
            span = hovered_span(lines[row], args.x)
            candidates = wrapped_candidates(lines, row, span) if span else []
        path = first_existing(candidates, args.cwd)
        items = []
        if path is not None:
            # A token avoids shell and tmux-format interpretation of the actual filename.
            token = base64.urlsafe_b64encode(os.fsencode(path)).decode()
            command = shlex.join([str(HERE / 'cockpit-pane-menu'), '--socket', args.socket,
                                  '--client', args.client, '--open', token])
            items += ['Open in Explorer', 'e', 'run-shell ' + shlex.quote(command), '']
        subprocess.run(tmux + ['display-menu', '-O', '-M', '-c', args.client, '-t', args.pane,
                              '-T', '#[align=centre] pane #{pane_index} ',
                              '-x', str(args.left + args.x), '-y', str(args.top + args.y)]
                       + items + pane_items(), check=True)
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        subprocess.run(tmux + ['display-message', '-c', args.client,
                              'cockpit: Explorer/menu: ' + str(error)], check=False)


if __name__ == '__main__':
    main()
