#!/usr/bin/env bash
# cockpit — a tmux control surface for your most-recent unfinished Claude sessions.
#
#   cockpit              restore the saved layout if one exists, else pick fresh
#                        (if a cockpit is already running, attaches to it)
#   cockpit --fresh      ignore the saved layout; pick sessions fresh
#   cockpit --restore    force-restore the saved layout
#   cockpit --history    list saved snapshots (id, time, panes, workspaces)
#   cockpit --restore-id ID   force-restore one specific snapshot from --history
#   cockpit --save       snapshot the running grid's layout to disk now
#   cockpit --santa      pick sessions in santa's TUI (resume → cockpit)
#   cockpit --rebuild    tear down a running cockpit, then build a fresh one
#   cockpit --auto       skip the picker: just open the top -n sessions
#   cockpit --list       dry run: show the candidate sessions
#   cockpit -n N         default selection / --auto pane count (default 5)
#   cockpit --attach     just attach to an existing cockpit
#   cockpit --kill       tear down the cockpit server
#   cockpit --reload     after a deploy: re-apply binds/hooks to the running grid, restart the poller
#
# Workspaces = tmux windows. A fresh build seeds one: 'work' (your picked
# sessions); spin up more on demand (Alt-N into a new workspace, or Alt-w). The
# status bar shows them as tabs, tinted by each workspace's most-urgent pane.
#
# Frame: each pane's TOP title is coloured by live state (green=working,
# blue=just-finished, red=needs-input, dim=idle); box borders are neutral and
# the active pane's border is yellow.
# Keys (no prefix needed):
#   Alt-←/→   switch workspace    Alt-w  new workspace
#   Alt-W     close workspace (10s timer)          Alt-u  undo a close
#   Alt-1..9  jump to pane        Alt-Tab  next attention-worthy pane
#   Alt-z     zoom toggle         Alt-i    collapse/restore idle panes
#   Alt-r     retarget pane → pick a dormant session (popup, list refreshed live)
#   Alt-n     add a pane: resume a session         Alt-N  new claude/codex/bash in a cwd
#   Alt-m     move pane → workspace (Alt-S-←/→ shove)   Alt-x  remove the active pane
#   Alt-s     browse santa's TUI; resume sends the session here (or jumps to it if already open)
#   Alt-f     find sessions related to the focused pane → add one to this workspace
#   Alt-/ , Alt-h , Alt-?     show the key reference popup
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"; source "$HERE/lib.sh"
# Honour COCKPIT_TMUX like every sibling script does. This was hardcoded, which
# meant any harness pointing the rest of cockpit at a throwaway socket still had
# THIS script build its grid on the live server — a test that quietly drives
# production is worse than no test, and it is why the restore path went so long
# without one.
TMUX=${COCKPIT_TMUX:-"tmux -L cockpit"}
# Orderlies are a separate controller domain.  They must never join or mutate
# Cockpit's dedicated server: pass only validated controller-domain scalars.
ensure_orderlies() { [[ -x "$HOME/tools/orderlies/orderlies-up" ]] && ( ORDERLIES_TMUX_SOCKET=orderlies ORDERLIES_SESSION=orderlies "$HOME/tools/orderlies/orderlies-up" >/dev/null 2>&1 & ) || true; }
N=5; MODE=build; AUTO=0; REBUILD=0; SANTA=0; RESTORE=0; FRESH=0
while [[ $# -gt 0 ]]; do case "$1" in
  --list|-l) MODE=list;; --attach|-a) MODE=attach;; --kill) MODE=kill;; --reload) MODE=reload;;
  --rebuild) REBUILD=1;; --auto) AUTO=1;; --santa) SANTA=1;;
  --restore) RESTORE=1;; --fresh) FRESH=1;; --save) MODE=save;; -n) N="$2"; shift;;
  --history) MODE=history;; --restore-from) RESTORE=1; RESTORE_BACK="$2"; shift;;
  --restore-id) RESTORE=1; RESTORE_ID="$2"; shift;;
  *) echo "unknown arg: $1" >&2; exit 2;; esac; shift; done
PENDING="${TMPDIR:-/tmp}/cockpit-pending.${COCKPIT_SESSION}"
# Saved layout (written by the poller); survives reboot. Now an append-only
# SQLite history — see cockpit_layout_* in lib.sh. LEGACY_STATE is the retired
# single-file TSV, imported once so an upgrade doesn't start with no layout.
LEGACY_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/cockpit/layout.${COCKPIT_SESSION}.tsv"
NIL='<nil>'

case "$MODE" in
  kill)   pkill -f "$HERE/cockpit-poller" 2>/dev/null || true
          $TMUX kill-server 2>/dev/null && echo "cockpit killed" || echo "no cockpit running"; exit 0;;
  attach) exec $TMUX attach -t "$COCKPIT_SESSION";;
  save)
    $TMUX has-session -t "$COCKPIT_SESSION" 2>/dev/null || { echo "no cockpit running to save" >&2; exit 1; }
    snap=$(cockpit_snapshot)
    if cockpit_layout_save "$snap"; then
      echo "cockpit: saved $(($(printf '%s\n' "$snap" | wc -l) - 1)) pane(s) → $COCKPIT_LAYOUT_DB"
    else echo "cockpit: save failed" >&2; exit 1; fi
    exit 0;;
  history)
    cockpit_layout_init
    sqlite3 -header -column "$COCKPIT_LAYOUT_DB" \
      "SELECT s.id, datetime(s.at,'unixepoch','localtime') AS saved, s.active,
              COUNT(p.seq) AS panes, COUNT(DISTINCT p.workspace) AS workspaces
       FROM snapshots s LEFT JOIN panes p ON p.snapshot_id=s.id
       WHERE s.session='$COCKPIT_SESSION' GROUP BY s.id ORDER BY s.at DESC, s.id DESC LIMIT ${N:-20};"
    exit 0;;
  list)
    printf '%-7s %-10s %-8s %-28s %s\n' "AGENT" "SESSION" "ACCOUNT" "CWD" "TITLE"
    cockpit_candidates "$N" | while IFS=$'\t' read -r id cwd title agent; do
      mark=$(cockpit_pane_account_display "$(cockpit_session_last_account "$id")" "${agent:-claude}")
      printf '%-7s %-10s %-8s %-28s %s\n' "${agent:-claude}" "${id:0:8}" "$mark" "${cwd/#$HOME/\~}" "$title"
    done; exit 0;;
esac

# --rebuild: tear down any existing cockpit first, so we always re-pick from
# scratch (and pick up the latest keybinds/chrome).
if [[ "$REBUILD" == 1 ]] && $TMUX has-session -t "$COCKPIT_SESSION" 2>/dev/null; then
  echo "cockpit: tearing down the running grid to rebuild…" >&2
  $TMUX kill-server 2>/dev/null || true
fi

# already running? With --santa, open the picker TUI first (its resume key adds
# panes live via the wt.exe shim), then attach. Otherwise just attach.
# (--reload wants the running session and is handled after the function
# definitions below, so it must not fall into the attach short-cut here.)
if [[ "$MODE" != reload ]] && $TMUX has-session -t "$COCKPIT_SESSION" 2>/dev/null; then
  if [[ "$SANTA" == 1 ]]; then
    echo "cockpit: opening santa — resume sends sessions into the grid…" >&2
    SANTA_RESUME_CMD="$HERE/cockpit-send" SANTA_RESUME_LABEL=cockpit PATH="$HERE/shim:$PATH" \
      COCKPIT_SEND="$HERE/cockpit-send" COCKPIT_TMUX="$TMUX" santa tui --provider cuda || true
    exec $TMUX attach -t "$COCKPIT_SESSION"
  fi
  echo "cockpit already running — attaching. ( --rebuild to re-pick · --santa to browse · --kill to tear down )" >&2
  ensure_orderlies
  exec $TMUX attach -t "$COCKPIT_SESSION"
fi

# choose which sessions to open (sets global CAND). Returns 1 if none chosen.
#   --santa : browse in santa's TUI; its resume key queues sessions (via
#             the wt.exe shim → cockpit-send), and we build from the queue on exit.
#   --auto / non-tty : top-N, no prompt.
#   default : the numbered picker (set pane count, skip stale ones).
select_cand() {
  if [[ "$SANTA" == 1 ]]; then
    : > "$PENDING"
    echo "cockpit: browse in santa, hit resume on the sessions you want, then quit the TUI." >&2
    SANTA_RESUME_CMD="$HERE/cockpit-send" SANTA_RESUME_LABEL=cockpit PATH="$HERE/shim:$PATH" \
      COCKPIT_SEND="$HERE/cockpit-send" COCKPIT_TMUX="$TMUX" santa tui --provider cuda || true
    mapfile -t CAND < <(awk -F'\t' 'NF>=2 && !seen[$1]++ {print}' "$PENDING" 2>/dev/null)
    [[ ${#CAND[@]} -gt 0 ]] || { echo "no sessions chosen in santa" >&2; return 1; }
  elif [[ "$AUTO" == 1 || ! -t 0 || ! -t 1 ]]; then
    mapfile -t CAND < <(cockpit_candidates "$N")
  else
    mapfile -t CAND < <(COCKPIT_DEFAULT_N="$N" "$HERE/cockpit-pick" startup)
  fi
  [[ ${#CAND[@]} -gt 0 ]] || { echo "no sessions selected" >&2; return 1; }
}

# server-wide look & feel + keybinds. Applied AFTER the first session exists:
# tmux ≥3.4 lets an empty server (start-server with no sessions) exit
# immediately, so any `set -g`/`bind` issued before the first new-session dies
# with "no server running" and set -e kills the script.
apply_chrome() {
  local i   # MUST be local: restore_grid calls this inside its `for ((i…))` loop,
            # and the Alt-1..9 bind loop below would otherwise clobber the counter.
  # Point panes at the stable agent socket (kept current by ssh-up.sh/.bashrc),
  # not whatever ephemeral SSH_AUTH_SOCK this long-lived server happened to freeze.
  # ssh's IdentityAgent also covers this, but env-based agent clients (ssh-add) need it.
  [ -e "$HOME/.ssh/agent.sock" ] && $TMUX set-environment -g SSH_AUTH_SOCK "$HOME/.ssh/agent.sock"
  $TMUX set -g pane-border-status top
  $TMUX set -g pane-border-lines heavy
  # State colour lives in the per-pane TOP line (@sc tints label + badge), not in
  # the box borders — adjacent columns share vertical borders, so a per-pane
  # border colour there is ambiguous and visibly cycles. Label left, status+time
  # right; the heavy line fills the gap. @sc is set per-pane by the poller.
  # The label is stored full and truncated HERE to pane_width-20 (≈ badge+pad),
  # so it uses whatever room the pane has — wide panes show more, narrow less.
  # A stamped @role prefixes the label with a compact glyph for known roles (bare codepoint, no VS16 — the
  # variation selector breaks tmux's border width math) or a bracketed text tag for anything else.
  # A bound Claude account comes FIRST, to the left of the role: its @account_mark (a single Greek letter,
  # single-cell — see cockpit_account_mark) if one is assigned, else a "· name " fallback so an unmarked
  # account is still visible rather than silently blank. The mark hugs a following role glyph with no space
  # of its own (`α🧱 label`, not `α 🧱 label`) — it emits a space only when there is NO role to butt up
  # against, so the mark-only case (`α label`) still separates cleanly; the dot fallback always keeps its
  # trailing space regardless, since "· name 🧱 label" reads fine either way. Nested #{?...} conditionals
  # read poorly inline, so both tag pieces are built in variables first.
  local role_tag='#{?@role,#{?#{==:#{@role},architect},📐 ,#{?#{==:#{@role},builder},🧱 ,[#{@role}] }},}'
  # A letter mark is never left bare: it's always terminated by either the role glyph that follows it
  # (flush, no space — the role segment's own trailing space separates from the label) or, when there is no
  # role, a centered dot before the label ("α· label", not "α label"). The "· name" unmarked-account
  # fallback is unaffected — it already carries its own trailing space either way.
  local account_tag='#{?@account_mark,#{@account_mark}#{?@role,,·},#{?@account,· #{@account} ,}}'
  # Truncation reserve bumped modestly (20 → 30 base) for the two new prefix segments; not split further per
  # role/account combination — a long unmarked account name can still crowd a narrow pane, but that is a rare
  # cosmetic edge case, not one worth a wider conditional.
  $TMUX set -g pane-border-format "#[align=left] #{@sc}${account_tag}${role_tag}#{=/#{e|-|:#{pane_width},#{?@role,42,30}}/…:#{?@label,#{@label},#{pane_index}}}#[default] #[align=right] #{@sc}#{?@badge,#{@badge},…}#[default] "
  # box borders: uniform neutral; only the active pane is highlighted (the one
  # case with no shared-edge ambiguity).
  $TMUX set -g pane-border-style 'fg=colour238'
  $TMUX set -g pane-active-border-style 'fg=colour220,bold'
  $TMUX set -g mouse on
  $TMUX set -g status-style 'bg=colour234,fg=colour250'
  $TMUX set -g status-left  ' cockpit '
  $TMUX set -g status-right '#[fg=colour39]#{@active_count} active#[default]  #{@finished_count} done  #{@idle_count} idle '
  $TMUX set -g status-right-length 60
  # workspaces = windows. Each tab is named, and the poller tints the name by the
  # workspace's most-urgent pane (@ws_badge) so a needs-input session glows even
  # when you're looking elsewhere. The current workspace gets a highlighted slab.
  $TMUX set -g status-justify centre        # workspace tabs centred on the bottom row
  $TMUX set -g window-status-separator ''
  $TMUX set -g window-status-style 'fg=colour245'
  $TMUX set -g window-status-current-style 'bg=colour238,fg=colour255,bold'
  $TMUX set -g window-status-format         ' #{?@ws_badge,#{@ws_badge},}#W#[default] '
  $TMUX set -g window-status-current-format ' #{?@ws_badge,#{@ws_badge},}#W '
  # keybinds (no-prefix Alt-…).
  # Server ops (select-pane, layout, kill) go via run-shell. But popups/menus
  # need a client, which run-shell has NOT — so the choosers/help are bound
  # DIRECTLY to display-popup (the keypress supplies the client). #{pane_id}
  # is expanded to the pane that was focused when the key was pressed.
  for i in 1 2 3 4 5 6 7 8 9; do $TMUX bind -n "M-$i" select-pane -t "$i" 2>/dev/null || true; done
  $TMUX bind -n M-Tab run-shell "$HERE/cockpit-next"
  $TMUX bind -n M-z   resize-pane -Z
  $TMUX bind -n M-i   run-shell "$HERE/cockpit-toggle-idle"
  # Fixed columns, not 90%: on a wide client 90% was ~252 columns of mostly empty space around
  # rows that are a tag, an age, a path and a title.
  $TMUX bind -n M-r   display-popup -E -w 120 -h 32 "$HERE/cockpit-pick retarget #{pane_id}"
  $TMUX bind -n M-n   display-popup -E -w 120 -h 32 "$HERE/cockpit-pick add"
  # Alt-N is three picker steps; the directory step lists every indexed cwd, so it wants height.
  # Fixed columns rather than 90%: the rows are paths and short labels, not the full grid width.
  $TMUX bind -n M-N   display-popup -E -w 96 -h 34 "$HERE/cockpit-pick new"
  # find sessions related to the focused pane's session → add a chosen one here
  $TMUX bind -n M-f   display-popup -E -w 120 -h 24 "$HERE/cockpit-related #{pane_id}"
  # browse in santa's TUI; its resume key drops the session into the grid.
  # --no-refresh is load-bearing: the TUI's launch-time ingest can take minutes on a large
  # history (and repaints a progress bar per file), so the popup would sit blank and never
  # reach the browse list. The hourly santa refresh cron keeps the index current anyway, so
  # the only cost is sessions started within the last hour (2026-08-25).
  $TMUX bind -n M-s   display-popup -E -w 95% -h 90% \
    "SANTA_RESUME_CMD=$HERE/cockpit-send SANTA_RESUME_LABEL=cockpit PATH=$HERE/shim:\$PATH COCKPIT_SEND=$HERE/cockpit-send COCKPIT_TMUX='$TMUX' santa tui --provider cuda --no-refresh"
  $TMUX bind -n M-x   run-shell "$HERE/cockpit-pane remove"
  $TMUX bind    x     run-shell "$HERE/cockpit-pane remove"   # C-b x → same recoverable kill
  # Swallow C-z: panes are `exec claude`, so an accidental Ctrl+Z suspends the agent
  # with no shell to `fg` from. Binding it here means tmux intercepts the key (the
  # agent never sees ^Z → can't be suspended), and cockpit-cont resumes anything
  # already stopped (no-op otherwise). C-b C-z still suspends the whole tmux client.
  $TMUX bind -n C-z   run-shell "$HERE/cockpit-cont #{pane_id}"
  # tmux's own STOCK menus are unbound first — every MouseDown3 variant — so nothing pops a menu that
  # cockpit didn't write. The two cockpit menus below (plain right-click on a pane, plain right-click on a
  # workspace tab) are then bound back; the Alt-modified variants stay dead. unbind-then-rebind on the same
  # key stays idempotent across repeated apply_chrome calls on a long-running server: a stale prior binding
  # is cleared before the current one is installed.
  $TMUX unbind -n MouseDown3Pane
  $TMUX unbind -n M-MouseDown3Pane
  $TMUX unbind -n MouseDown3Status
  $TMUX unbind -n MouseDown3StatusLeft
  $TMUX unbind -n M-MouseDown3Status
  $TMUX unbind -n M-MouseDown3StatusLeft
  # The cockpit pane menu lives on plain right-click, WITH a y/n guard on its two destructive entries (tmux
  # `confirm-before`) — so a stray/accidental click can't fire a kill or a restart; only an explicit menu
  # choice followed by an explicit confirm does. Kill routes through the soft-kill so Alt-u can undo it;
  # Restart onto cockpit-restart (respawns the CLICKED pane's resume in place — same session, same binding —
  # to pick up a freshly released provider binary; #{pane_id} in a display-menu bound via -t = resolves to
  # the pane under the mouse, not the one that happened to be focused). Zoom/Move/Swap are non-destructive
  # and stay unconfirmed.
  $TMUX bind -n MouseDown3Pane select-pane -t = '\;' display-menu -T "#[align=centre] pane #{pane_index} " -x M -y M \
    "#{?window_zoomed_flag,Unzoom,Zoom}" z "resize-pane -Z" \
    "#{?#{==:#{window-size},manual},Full width,Half width}" w "run-shell \"$HERE/cockpit-ws toggle #{window_id}\"" \
    "Kill (undoable)" k "confirm-before -p \"kill pane #{pane_index}? (y/n)\" \"run-shell \\\"$HERE/cockpit-pane remove\\\"\"" \
    "Restart"         r "confirm-before -p \"restart pane #{pane_index}? (y/n)\" \"run-shell \\\"$HERE/cockpit-restart '#{pane_id}'\\\"\"" \
    "Move to next ws" m "run-shell \"$HERE/cockpit-move next\"" \
    "Swap up"         u "swap-pane -U" \
    "Swap down"       d "swap-pane -D"
  # Workspace menu on right-clicking a tab. Same shape of guard as the pane menu: the one destructive
  # entry (Close) is behind `confirm-before` AND routes through cockpit-ws's 10s soft-close, so it is
  # doubly recoverable — y/n first, then Alt-u for the ten seconds after. Everything else here (switch,
  # rename, swap, new) is non-destructive and unconfirmed. Unlike tmux's stock status menu this has no
  # Kill and no Respawn: a workspace holds live agent panes, and neither had an undo.
  # #{window_id}/#{window_name} resolve against the tab UNDER THE MOUSE (display-menu -t =), not the
  # focused workspace, so the menu acts on what you clicked even from another tab. Move left/right must
  # select the clicked tab FIRST: swap-window's `:-1`/`:+1` are relative to the CURRENT window, so without
  # that they'd shuffle the focused workspace's neighbours instead of the clicked one's (tmux's own stock
  # status menu has exactly that bug).
  $TMUX bind -n MouseDown3Status display-menu -T "#[align=centre] #{window_name} " -t = -x W -y W \
    "Switch here"      s "select-window -t =" \
    "Rename…"          n "command-prompt -F -I \"#{window_name}\" \"rename-window -t '#{window_id}' -- '%%'\"" \
    "" \
    "#{?#{>:#{session_windows},1},,-}Move left"  "<" "select-window -t = ; swap-window -t:-1" \
    "#{?#{>:#{session_windows},1},,-}Move right" ">" "select-window -t = ; swap-window -t:+1" \
    "" \
    "New workspace"    w "command-prompt -p \"new workspace:\" \"new-window -a -t '#{window_id}' -n '%%' 'bash -l'\"" \
    "" \
    "Close (undoable)" k "confirm-before -p \"close workspace '#{window_name}' and its panes? (y/n)\" \"run-shell \\\"$HERE/cockpit-ws close '#{window_id}'\\\"\""
  # move the active pane to another workspace: Alt-m to pick/create, Alt-Shift-←/→ to shove
  # -h 32 fits ~24 rows of list: enough to show every workspace without scrolling at the counts
  # this grid actually runs. The picker scrolls inside its frame when it doesn't fit, so a small
  # client clamps gracefully rather than pushing the border off-screen the way the old numbered
  # prompt did (28 emitted lines into a 24-row popup once you passed ~19 workspaces).
  $TMUX bind -n M-m       display-popup -E -w 72 -h 32 "$HERE/cockpit-move pick #{pane_id}"
  $TMUX bind -n M-S-Left  run-shell "$HERE/cockpit-move prev"
  $TMUX bind -n M-S-Right run-shell "$HERE/cockpit-move next"
  # workspaces: switch with Alt-←/→, create with Alt-w, close with Alt-W
  $TMUX bind -n M-Left  previous-window
  $TMUX bind -n M-Right next-window
  $TMUX bind -n M-w command-prompt -p "new workspace:" "new-window -n '%%' 'bash -l'"
  # close a workspace on a 10s recoverable timer (Alt-u to undo); also reroute
  # the default prefix kill-window (C-b &) through the same soft-close.
  $TMUX bind -n M-W run-shell "$HERE/cockpit-ws close"
  $TMUX bind -n M-u run-shell "$HERE/cockpit-undo"     # undo last ws-close OR pane-kill
  $TMUX bind '&'    run-shell "$HERE/cockpit-ws close"
  # Solo width: a one-pane workspace is narrowed to COCKPIT_SOLO_WIDTH% (see
  # cockpit-ws fit). Hooks catch every way a pane count or terminal size changes;
  # after-new-window is separate because a brand-new window fires no layout event,
  # and #{hook_window} is only populated for window-layout-changed (empty → fit all).
  $TMUX set-hook -g window-layout-changed "run-shell \"$HERE/cockpit-ws fit #{hook_window}\""
  $TMUX set-hook -g after-new-window      "run-shell \"$HERE/cockpit-ws fit\""
  $TMUX set-hook -g client-attached       "run-shell \"$HERE/cockpit-ws fit\""
  $TMUX set-hook -g client-resized        "run-shell \"$HERE/cockpit-ws fit\""
  $TMUX bind -n M-/   display-popup -E -w 64 -h 42 "$HERE/cockpit-help show"
  $TMUX bind -n M-h   display-popup -E -w 64 -h 42 "$HERE/cockpit-help show"
  $TMUX bind -n M-?   display-popup -E -w 64 -h 42 "$HERE/cockpit-help show"
}

stamp_pane() {  # pane-id  session-id  cwd  label  [agent]  [role]
  cockpit_stamp_known_agent "$1" "$2" "$3" "$4" "${5:-claude}" "${6:-}"
}

# Restore controller-owned identity from the snapshot. Legacy snapshots carry no
# tuple at all and are deliberately left unstamped for the controller to adopt.
#
# A pane the controller has NOT adopted yet is the same shape as legacy at the
# pane level but still reports a workspaceRef, because @cockpit_workspace_ref is
# a WINDOW option and tmux resolves user options pane → window: every pane in an
# adopted workspace inherits it, adopted or not. Reading that as corruption is
# what made a fresh WSL boot unrestorable on 2026-08-18 — five never-adopted
# panes aborted the rebuild at pane 14 of 53 and the grid fell back to a fresh
# pick. Un-adopted is a legal state; the controller mints the paneRef on its
# next pass. Only the pane-level tuple itself has to be whole.
stamp_controller_identity() { # pane-id window-id workspace-ref pane-ref generation version badge
  local pane="$1" win="$2" wref="$3" pref="$4" gen="$5" ver="$6" badge="$7"
  [[ -n "$wref" ]] && $TMUX set-option -w -t "$win" @cockpit_workspace_ref "$wref"
  [[ -n "$badge" ]] && $TMUX set-option -p -t "$pane" @cockpit_badge "$badge"
  # no pane-level identity saved → hand the pane to the controller unstamped
  [[ -z "$pref$gen$ver" ]] && return 0
  # A half-written pane tuple is the one thing we will not project: an identity
  # the controller would trust but cannot verify. Skip THIS pane (the controller
  # re-adopts it) rather than abandoning the rebuild — a bad row costs one pane's
  # identity, never the other 52 panes.
  if [[ -z "$wref" || -z "$pref" || ! "$gen" =~ ^[1-9][0-9]*$ || ! "$ver" =~ ^[1-9][0-9]*$ ]]; then
    echo "cockpit: dropping a partial controller identity for pane $pane — leaving it for the controller to adopt" >&2
    $TMUX set-option -pu -t "$pane" @cockpit_pane_ref 2>/dev/null
    $TMUX set-option -pu -t "$pane" @cockpit_pane_generation 2>/dev/null
    $TMUX set-option -pu -t "$pane" @cockpit_pane_version 2>/dev/null
    return 0
  fi
  $TMUX set-option -p -t "$pane" @cockpit_pane_ref "$pref" \
    \; set-option -p -t "$pane" @cockpit_pane_generation "$gen" \
    \; set-option -p -t "$pane" @cockpit_pane_version "$ver"
}

# Bulk Codex launches are queued while the layout is built.  After every pane
# exists, respawn the saved active workspace first and the remaining workspaces
# second.  This changes initialization priority without changing tab/pane order.
declare -a CODEX_QUEUE_PANES=() CODEX_QUEUE_WORKSPACES=() CODEX_QUEUE_COMMANDS=()
codex_queue_reset() {
  CODEX_QUEUE_PANES=(); CODEX_QUEUE_WORKSPACES=(); CODEX_QUEUE_COMMANDS=()
}
codex_queue_add() {
  CODEX_QUEUE_PANES+=("$1"); CODEX_QUEUE_WORKSPACES+=("$2"); CODEX_QUEUE_COMMANDS+=("$3")
}
codex_queue_launch() {
  local active="$1" pass i ordinal=0 cmd workspace
  for pass in active remaining; do
    for ((i=0;i<${#CODEX_QUEUE_PANES[@]};i++)); do
      workspace="${CODEX_QUEUE_WORKSPACES[$i]}"
      if [[ "$pass" == active ]]; then
        [[ -n "$active" && "$workspace" == "$active" ]] || continue
      else
        [[ -z "$active" || "$workspace" != "$active" ]] || continue
      fi
      cmd=$(cockpit_stagger_agent_command codex "$ordinal" "${CODEX_QUEUE_COMMANDS[$i]}")
      $TMUX respawn-pane -k -t "${CODEX_QUEUE_PANES[$i]}" "bash -lc $(printf %q "$cmd")"
      ordinal=$((ordinal+1))
    done
  done
}

# launch exactly one poller (clears stragglers, fully detached) and attach.
launch_and_attach() {
  # COCKPIT_NO_SINGLETON is the poller's existing "I'm a throwaway instance"
  # hatch; respect it here too, so a test grid neither evicts the live poller
  # nor starts the orderly fleet behind the operator's back.
  if [[ -z "${COCKPIT_NO_SINGLETON:-}" ]]; then
    pkill -f "$HERE/cockpit-poller" 2>/dev/null || true
    COCKPIT_TMUX="$TMUX" setsid nohup "$HERE/cockpit-poller" >/tmp/cockpit-poller.log 2>&1 &
    ensure_orderlies
  fi
  exec $TMUX attach -t "$COCKPIT_SESSION"
}

# fresh build: a single 'work' workspace from CAND. Need a transient/extra zone?
# spin one up on demand — Alt-N (new session → new workspace) or Alt-w.
build_from_cand() {
  local first=1 row id cwd title agent cmd pane key
  declare -A SEEN_SESSION=()
  codex_queue_reset
  for row in "${CAND[@]}"; do
    # A 5th field is the optional Claude account NAME. cockpit-send writes it when it queues a session for a
    # cold build; every other producer (cockpit_candidates, cockpit-pick) emits four fields and reads as "".
    local acct acct_ok acct_reason tok mark; local -a eargs
    IFS=$'\t' read -r id cwd title agent acct <<< "$row"; [[ -n "$agent" ]] || agent=claude
    acct_ok=1; acct_reason=""; tok=""; eargs=()
    cockpit_account_name_ok "${acct:-}" || acct=""
    key="$agent:$id"
    [[ -n "${SEEN_SESSION[$key]:-}" ]] && continue
    SEEN_SESSION[$key]=1
    # Same rule as restore: the token rides `-e` at pane creation, and an account that no longer resolves
    # refuses visibly rather than falling back to the primary subscription (see cockpit_account_token).
    if [[ -n "$acct" ]]; then
      if tok=$(cockpit_account_token "$acct" 2>/dev/null); then eargs=(-e "CLAUDE_CODE_OAUTH_TOKEN=$tok")
      else acct_ok=0; acct_reason=$(cockpit_account_token "$acct" 2>&1 >/dev/null) || true; fi
    fi
    cmd=$(agent_resume_inner "$agent" "$id" "$cwd" "$title")
    [[ "$agent" == codex ]] && cmd="exec sleep infinity"
    (( acct_ok )) || cmd=$(cockpit_account_refuse_cmd "$acct" "$acct_reason")
    if (( first )); then
      # See restore_grid: `new-session -e` sets the SESSION environment (readable, and inherited by every
      # later pane), so an account-bound first pane is created on a holder and respawned with the token.
      if (( ${#eargs[@]} )); then
        pane=$($TMUX new-session -d -P -F '#{pane_id}' -s "$COCKPIT_SESSION" -n work -x 320 -y 80 "exec sleep infinity")
        $TMUX respawn-pane -k -t "$pane" "${eargs[@]}" "bash -lc $(printf %q "$cmd")"
      else
        pane=$($TMUX new-session -d -P -F '#{pane_id}' -s "$COCKPIT_SESSION" -n work -x 320 -y 80 "bash -lc $(printf %q "$cmd")")
      fi
      apply_chrome; first=0
    else
      pane=$($TMUX split-window -t "$COCKPIT_SESSION:work" -P -F '#{pane_id}' "${eargs[@]}" "bash -lc $(printf %q "$cmd")")
      $TMUX select-layout -t "$COCKPIT_SESSION:work" "$COCKPIT_LAYOUT"
    fi
    stamp_pane "$pane" "$id" "$cwd" "$title" "$agent"
    { [[ -n "$acct" ]] && $TMUX set -p -t "$pane" @account "$acct"; } || true
    # @account_mark is cosmetic and derived (never persisted) — recomputed right beside @account.
    # cockpit_pane_account_mark folds in the "unmarked default account still gets its own mark, Claude-only"
    # rule, so this can no longer gate on $acct alone (a claude pane with NO account still needs a mark).
    # `[[ -z ]] ||`, not a trailing `[[ -n ]] &&`, so this line's own rc never depends on the mark's content.
    mark=$(cockpit_pane_account_mark "$acct" "$agent")
    { [[ -z "$mark" ]] || $TMUX set -p -t "$pane" @account_mark "$mark"; } || true
    if (( acct_ok )) && [[ "$agent" == codex ]]; then
      cmd=$(cockpit_keep_pane_on_failure "$(agent_resume_inner "$agent" "$id" "$cwd" "$title")")
      codex_queue_add "$pane" work "$cmd"
    fi
  done
  $TMUX select-layout -t "$COCKPIT_SESSION:work" "$COCKPIT_LAYOUT"
  $TMUX select-window -t "$COCKPIT_SESSION:work"
  codex_queue_launch work
}

# rebuild the saved workspaces/panes from the layout store. Returns 1 if there's
# nothing resumable (caller then falls back to a fresh pick). $1 = how many
# snapshots to step back (0 = newest), so a restore that came out wrong can be
# retried against the grid as it stood before — `cockpit --restore-from 1`.
restore_grid() {
  local back="${1:-0}" snap
  cockpit_layout_import_legacy "$LEGACY_STATE"
  if [[ -n "${RESTORE_ID:-}" ]]; then
    snap=$(cockpit_layout_load_id "$RESTORE_ID") \
      || { echo "cockpit: no snapshot $RESTORE_ID for session '$COCKPIT_SESSION' (see: cockpit --history)" >&2; return 1; }
  else
    snap=$(cockpit_layout_load "$back") || return 1
  fi
  [[ -n "$snap" ]] || return 1
  local active="" first=1 curwin="" awin="" i n resumable=0 duplicates=0 key duplicate_noun
  declare -a W S C L A WR PR PG PV B O AC RL; local f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 f13 f14
  while IFS=$'\t' read -r f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 f13 f14; do
    [[ "$f1" == "@active" ]] && { active="$f2"; continue; }
    # Guard against a malformed layout file: a pane row's f1 is a window index
    # and f2 a workspace name. Skip anything else (blank lines, or continuation
    # fragments from a label that pre-fix corruption split across rows) so a bad
    # file degrades to fewer panes instead of `NAMEWIN[""]` "bad array subscript".
    [[ "$f1" =~ ^[0-9]+$ && -n "$f2" ]] || continue
    [[ "$f3" == "$NIL" ]] && f3=""; [[ "$f4" == "$NIL" ]] && f4=""; [[ "$f5" == "$NIL" ]] && f5=""
    [[ "$f6" == "$NIL" ]] && f6=""
    [[ "$f7" == "$NIL" ]] && f7=""; [[ "$f8" == "$NIL" ]] && f8=""
    [[ "$f9" == "$NIL" ]] && f9=""; [[ "$f10" == "$NIL" ]] && f10=""
    [[ "$f11" == "$NIL" ]] && f11=""; [[ "$f12" == "$NIL" ]] && f12=""
    [[ "$f13" == "$NIL" ]] && f13=""
    [[ "$f14" == "$NIL" ]] && f14=""
    [[ "$f6" == claude || "$f6" == codex ]] || f6=""
    # f13 is a Claude account NAME (never a token). A row that does not parse as one is dropped rather than
    # carried: the launch below treats "has an account" as "must resolve", so a junk value must not reach it.
    cockpit_account_name_ok "$f13" || f13=""
    # f14 is the pane's @role tag; a row that does not parse as one is dropped the same way.
    cockpit_role_ok "$f14" || f14=""
    W+=("$f2"); S+=("$f3"); C+=("$f4"); L+=("$f5"); A+=("$f6")
    WR+=("$f7"); PR+=("$f8"); PG+=("$f9"); PV+=("$f10"); B+=("$f11"); O+=("$f12"); AC+=("$f13"); RL+=("$f14")
  done <<<"$snap"
  n=${#W[@]}; (( n > 0 )) || return 1
  declare -A SEEN_RESUMABLE=()
  for ((i=0;i<n;i++)); do
    if [[ ( "${A[$i]}" == claude || "${A[$i]}" == codex ) && -n "${S[$i]}" && -n "$(agent_transcript "${A[$i]}" "${S[$i]}" "${C[$i]}")" ]]; then
      key="${A[$i]}:${S[$i]}"
      if [[ -n "${SEEN_RESUMABLE[$key]:-}" ]]; then duplicates=$((duplicates+1))
      else SEEN_RESUMABLE[$key]=1; resumable=$((resumable+1))
      fi
    fi
  done
  (( resumable > 0 )) || return 1
  echo "cockpit: restoring $resumable session(s) from saved layout…" >&2
  if (( duplicates > 0 )); then
    [[ $duplicates == 1 ]] && duplicate_noun=entry || duplicate_noun=entries
    echo "cockpit: ignored $duplicates duplicate session $duplicate_noun" >&2
  fi
  # Group rows into windows by workspace NAME (NAMEWIN: name → window_id), NOT by
  # adjacency. The saved rows are in window-index order, so two windows that share a
  # name but are separated by a differently-named window (e.g. banktech … codex …
  # banktech) used to rebuild as TWO "banktech" tabs. Keying on the name collapses
  # them into one; recording each name's FIRST appearance preserves the tab ORDER the
  # user is used to (sorting the rows instead would alphabetise the whole grid).
  declare -A SEENW NAMEWIN SEEN_LAUNCHED
  codex_queue_reset
  for ((i=0;i<n;i++)); do
    local wname="${W[$i]}" sid="${S[$i]}" cwd="${C[$i]}" label="${L[$i]}" agent="${A[$i]}" issess=0 cmd pane
    local wref="${WR[$i]}" pref="${PR[$i]}" gen="${PG[$i]}" ver="${PV[$i]}" badge="${B[$i]}" orb="${O[$i]:-}"
    local acct="${AC[$i]:-}" acct_ok=1 acct_reason="" tok=""; local -a eargs=()
    local role="${RL[$i]:-}" mark
    # ── the per-pane Claude account, resolved BEFORE the pane is created ──────────────────────────────────
    # The token is delivered through tmux's `-e`, which applies the environment to the child process at
    # exec — so it has to be decided here, not stamped on afterwards. And if it no longer resolves we must
    # NOT fall through to a normal launch: CLAUDE_CODE_OAUTH_TOKEN empty/absent means "use the primary
    # account", so a silent fallback bills the exact subscription this binding exists to protect, with
    # nothing on screen. Refuse visibly instead, in a pane that stays alive to be read.
    if [[ -n "$acct" ]]; then
      if tok=$(cockpit_account_token "$acct" 2>/dev/null); then
        eargs=(-e "CLAUDE_CODE_OAUTH_TOKEN=$tok")
      else
        acct_ok=0; acct_reason=$(cockpit_account_token "$acct" 2>&1 >/dev/null) || true
      fi
    fi
    [[ ( "$agent" == claude || "$agent" == codex ) && -n "$sid" && -n "$(agent_transcript "$agent" "$sid" "$cwd")" ]] && issess=1
    if (( issess )); then
      key="$agent:$sid"
      [[ -n "${SEEN_LAUNCHED[$key]:-}" ]] && continue
      SEEN_LAUNCHED[$key]=1
      cmd=$(cockpit_keep_pane_on_failure "$(agent_resume_inner "$agent" "$sid" "$cwd" "$label" "$orb")")
      [[ "$agent" == codex ]] && cmd="exec sleep infinity"
    else
      cmd="bash -l"
    fi
    # An unresolved account overrides every launch above. issess is deliberately left alone so the pane is
    # still stamped with its session id/cwd/label — otherwise the next autosave would write the binding AND
    # the session away, and the refusal would cost the operator the pane it was protecting.
    (( acct_ok )) || cmd=$(cockpit_account_refuse_cmd "$acct" "$acct_reason")
    if [[ -z "${NAMEWIN[$wname]:-}" ]]; then      # first sighting of this workspace → open its window
      if (( first )); then
        if (( ${#eargs[@]} )); then
          # `new-session -e` is NOT the same as `split-window -e`/`new-window -e`/`respawn-pane -e`. Those
          # three set the environment of the newly created PROCESS; new-session sets it on the SESSION, where
          # it is readable via `show-environment` for the rest of the grid's life AND inherited by every pane
          # created afterwards. Both are wrong for a credential: the token would be dumpable from any pane,
          # and unbound panes would silently run on the second account. So the first pane is created on a
          # holder and respawned with the token instead — respawn-pane -e is process-scoped (verified).
          pane=$($TMUX new-session -d -P -F '#{pane_id}' -s "$COCKPIT_SESSION" -n "$wname" -x 320 -y 80 "exec sleep infinity")
          $TMUX respawn-pane -k -t "$pane" "${eargs[@]}" "bash -lc $(printf %q "$cmd")"
        else
          pane=$($TMUX new-session -d -P -F '#{pane_id}' -s "$COCKPIT_SESSION" -n "$wname" -x 320 -y 80 "bash -lc $(printf %q "$cmd")")
        fi
        apply_chrome; first=0
      else
        pane=$($TMUX new-window -t "$COCKPIT_SESSION" -P -F '#{pane_id}' -n "$wname" "${eargs[@]}" "bash -lc $(printf %q "$cmd")")
      fi
      curwin=$($TMUX display -p -t "$pane" '#{window_id}'); SEENW[$curwin]=1; NAMEWIN[$wname]="$curwin"
      [[ "$wname" == "$active" ]] && awin="$curwin"
      (( issess )) && stamp_pane "$pane" "$sid" "$cwd" "$label" "$agent" "$role"
    else                                          # workspace already open → add this pane to its window
      curwin="${NAMEWIN[$wname]}"
      pane=$($TMUX split-window -t "$curwin" -P -F '#{pane_id}' "${eargs[@]}" "bash -lc $(printf %q "$cmd")")
      (( issess )) && stamp_pane "$pane" "$sid" "$cwd" "$label" "$agent" "$role"
    fi
    # Carry the orb binding forward, or the fix survives exactly one reboot. Braced with `|| true` because this
    # is the loop body's last command under `set -e`, and no binding is the normal case for every other pane.
    { [[ -n "$orb" ]] && $TMUX set -p -t "$pane" @orb_server_file "$orb"; } || true
    # Re-stamp the account NAME (never the token) so it survives THIS restore into the next snapshot. A pane
    # that came up refusing keeps its binding too: the operator fixes the token file and restores again.
    { [[ -n "$acct" ]] && $TMUX set -p -t "$pane" @account "$acct"; } || true
    # @account_mark is cosmetic and derived (never persisted in the layout DB) — recomputed here the same
    # way, right beside the account it marks. cockpit_pane_account_mark folds in the "unmarked default
    # account still gets its own mark, Claude-only" rule, so this gates on the RESULT, not on $acct alone
    # (a restored claude pane with no account still needs a mark). `[[ -z ]] ||`, never `[[ -n ]] &&`.
    mark=$(cockpit_pane_account_mark "$acct" "$agent")
    { [[ -z "$mark" ]] || $TMUX set -p -t "$pane" @account_mark "$mark"; } || true
    # Re-stamp @role the same way — it's a property of the pane the operator dedicated, not of whether this
    # pane happens to hold a resumable session (stamp_pane above only fires when issess is true).
    { [[ -n "$role" ]] && $TMUX set -p -t "$pane" @role "$role"; } || true
    stamp_controller_identity "$pane" "$curwin" "$wref" "$pref" "$gen" "$ver" "$badge" || true
    # A refusing pane is never queued for a real provider start — that is the whole point of refusing.
    if (( issess && acct_ok )) && [[ "$agent" == codex ]]; then
      cmd=$(cockpit_keep_pane_on_failure "$(agent_resume_inner "$agent" "$sid" "$cwd" "$label" "$orb")")
      codex_queue_add "$pane" "$wname" "$cmd"
    fi
  done
  for w in "${!SEENW[@]}"; do $TMUX select-layout -t "$w" "$COCKPIT_LAYOUT" 2>/dev/null; done
  [[ -n "$awin" ]] && $TMUX select-window -t "$awin" 2>/dev/null
  codex_queue_launch "$active"
  return 0
}

# The layout store is append-only, so the grid that vanished is still on disk —
# but restore takes the NEWEST snapshot, and the newest snapshot of a grid that
# just lost 23 workspaces is a grid with one workspace. That is how a recoverable
# hour became an unrecoverable morning on 2026-08-12: cockpit rebuilt the wreck
# without a word, and only the operator knew anything was missing.
# So: before building anything, compare what we're about to restore against the
# richest layout in recent history. A shrink can be deliberate (workspaces do get
# closed), so this never switches silently — it says what it found and, at a
# terminal, offers the fuller snapshot. Skipped when the operator named an id.
restore_shrink_check() {
  local back="${1:-0}" cid cws cpanes pid pws ppanes ans
  IFS=$'\t' read -r cid cws cpanes < <(cockpit_layout_stats "$back") || return 0
  IFS=$'\t' read -r pid pws ppanes < <(cockpit_layout_peak 30) || return 0
  [[ "$cws" =~ ^[0-9]+$ && "$pws" =~ ^[0-9]+$ ]] || return 0
  (( cws > 0 && pid != cid && pws >= cws * 2 && pws - cws >= 2 )) || return 0
  echo "cockpit: the newest layout has $cws workspace(s) / $cpanes pane(s)," >&2
  echo "         but snapshot $pid has $pws / $ppanes — something closed the grid, not you?" >&2
  if [[ -t 0 && -t 1 ]]; then
    printf '         [r] restore snapshot %s instead   [k] keep the newest  (k in 20s): ' "$pid" >&2
    read -r -t 20 -n 1 ans </dev/tty || true; echo >&2
    [[ "${ans:-}" == [rR] ]] && { RESTORE_ID="$pid"; echo "cockpit: restoring snapshot $pid" >&2; }
  else
    echo "         restore it with: cockpit --restore-id $pid" >&2
  fi
}

# ---- reload: hot-apply a deploy to the running grid ----
# Binds, menus and hooks live in the tmux server and the poller is a long-lived
# process, so a deploy that only swaps files changes nothing until both are
# refreshed. This is the deploy's last step (see AGENTS.md); no attach, no rebuild.
if [[ "$MODE" == reload ]]; then
  $TMUX has-session -t "$COCKPIT_SESSION" 2>/dev/null || { echo "no cockpit running to reload" >&2; exit 1; }
  apply_chrome
  pkill -f "$HERE/cockpit-poller" 2>/dev/null || true
  COCKPIT_TMUX="$TMUX" setsid nohup "$HERE/cockpit-poller" >/tmp/cockpit-poller.log 2>&1 &
  "$HERE/cockpit-ws" fit 2>/dev/null || true
  echo "cockpit: reloaded chrome + poller from $HERE ($(git -C "$HERE" log --oneline -1 2>/dev/null || echo 'not a checkout'))"
  exit 0
fi

# ---- orchestrate: restore the saved layout, else pick fresh ----
# Default plain `cockpit` auto-restores when a layout exists; --fresh/--auto/
# --santa force a fresh pick, --restore forces restore.
want_restore=0
cockpit_layout_import_legacy "$LEGACY_STATE"
if [[ "$RESTORE" == 1 ]]; then want_restore=1
elif [[ "$SANTA" == 0 && "$AUTO" == 0 && "$FRESH" == 0 ]] && cockpit_layout_load >/dev/null 2>&1; then want_restore=1; fi

if (( want_restore )); then
  [[ -n "${RESTORE_ID:-}" ]] || restore_shrink_check "${RESTORE_BACK:-0}"
  restore_grid "${RESTORE_BACK:-0}" && launch_and_attach     # success → never returns
  [[ "$RESTORE" == 1 ]] && echo "cockpit: no saved layout to restore — starting fresh" >&2
fi

select_cand || exit 0
build_from_cand
launch_and_attach
