#!/usr/bin/env bash
# cockpit-poller — watches each pane's transcript and paints live state onto
# the frame. Runs as a background daemon spawned by `cockpit`. One per server.
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"; source "$HERE/lib.sh"
TMUX=${COCKPIT_TMUX:-"tmux -L cockpit"}
INTERVAL="${COCKPIT_INTERVAL:-2}"

# --- singleton -------------------------------------------------------------
# Only ONE poller per session may paint. Two or more independently compute the
# just-finished latch and both rewrite pane-border-style every cycle, so they
# fight over the same borders — the gray/blue flicker. Kill any other poller
# for this socket before we start, and drop a pidfile.
PIDFILE="${TMPDIR:-/tmp}/cockpit-poller.${COCKPIT_SESSION}.pid"
# Escape hatch for testing a second poller on a throwaway socket without it
# evicting the real one (the scan below is socket-agnostic — it matches by argv).
if [[ -z "${COCKPIT_NO_SINGLETON:-}" ]]; then
# Match ONLY a real poller: its argv is exactly `bash …/cockpit-poller`, so the
# joined cmdline ends in "cockpit-poller". This deliberately won't match the
# launcher's `… nohup …/cockpit-poller >log` wrapper or a `pgrep cockpit-poller`
# (those have trailing text), so we never kill the wrong process.
for p in $(pgrep -f cockpit-poller 2>/dev/null); do
  [[ "$p" == "$$" || "$p" == "$PPID" ]] && continue
  [[ -r "/proc/$p/cmdline" ]] || continue          # pid vanished between calls
  c=$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null)
  [[ "$c" == *"cockpit-poller " ]] && kill "$p" 2>/dev/null || true
done
echo $$ >"$PIDFILE"
trap 'rm -f "$PIDFILE"' EXIT
fi

declare -A PREV       # pane_id -> last raw state
declare -A FIN        # pane_id -> 1 if in just-finished (cleared when visited)
declare -A LASTSTYLE  # pane_id -> last border style WE wrote (skip redundant writes)
declare -A LASTBADGE  # pane_id -> last badge WE wrote
declare -A LASTLABEL  # pane_id -> last label seen/written (so titles can upgrade)
declare -A LASTSTATE  # pane_id -> last @state written (setting it repaints the border)
declare -A PREV_WCOUNT # window_id -> last pane count (re-tile that window on change)
declare -A LASTWS     # window_id -> last @ws_badge written (workspace tab colour)
declare -A ADOPTED    # session id -> already claimed by a pane (Alt-N new sessions)
declare -A LASTACT    # pane_id -> last @activity_at written (skip redundant writes)
declare -A TPATH      # agent|session|cwd|account -> resolved transcript path
declare -A STAT       # transcript path -> "mtime size", from one stat call per cycle
declare -A FACTKEY    # pane_id -> "path mtime size" the cached FACTS were read at
declare -A FACTS      # pane_id -> agent_facts of its transcript (re-read only when the file changes)
declare -A TITLE      # session id -> santa's title this refresh
declare -A CLEAN      # raw santa title -> ck_clean_label of it
prev_counts=""        # last @active/@finished/@idle trio written (skip no-op status writes)
# CPU budget: with ~75 panes the poller used to cost most of a core, because every pane on every cycle
# re-resolved its transcript (a Python start for the account roots, a `find` over every Codex rollout),
# re-parsed its last line with three jq runs, and forked a dozen subshells. Now transcript paths are cached
# per (agent, session, cwd, account), so an account switch or a cwd restamp resolves afresh; a path is dropped
# when its file vanishes, and all of them when the account roots change (re-checked on this timer, so a new
# account shows within a minute). One stat per cycle covers every transcript, a transcript is re-read only
# when its mtime or size moves, and the helpers below set variables instead of echoing into $(…).
RESOLVE_EVERY="${COCKPIT_RESOLVE_SECS:-60}"; next_resolve=0
# Labels are stamped once at pane creation, often from a fallback (first prompt)
# before santa has summarised the session. Re-query the DB occasionally
# and upgrade the @label when a better title lands — throttled, not every cycle.
TITLE_REFRESH="${COCKPIT_TITLE_REFRESH:-15}"
next_titles=0
# Per-pane read format. Two gotchas: IFS=$'\t' treats tab as whitespace and
# COLLAPSES empty fields (a pending pane's blank @session_id would shift every
# later field), and tmux escapes raw control bytes so a non-whitespace separator
# can't pass through -F. Fix: tab-separate but emit a <nil> token for any blank
# field so nothing is ever empty (→ no collapse), then restore "" after reading.
TAB=$'\t'; NIL='<nil>'
PANE_FMT="#{window_id}${TAB}#{pane_id}${TAB}#{?@session_id,#{@session_id},$NIL}${TAB}#{?@cwd,#{@cwd},$NIL}${TAB}#{?@label,#{@label},$NIL}${TAB}#{?@born,#{@born},$NIL}${TAB}#{?@agent,#{@agent},$NIL}${TAB}#{?@hook_state,#{@hook_state},$NIL}${TAB}#{?@hook_at,#{@hook_at},$NIL}${TAB}#{?@state,#{@state},$NIL}${TAB}#{?@account,#{@account},$NIL}"
# How long an event-driven hook state (set by cockpit-hook) is trusted before we
# fall back to tail-parsing the transcript. Active sessions refresh @hook_at on
# every event, so this only bounds how long a stale state lingers after a missed
# edge / crash. Generous enough not to second-guess a quietly-idle session.
HOOK_TTL="${COCKPIT_HOOK_TTL:-900}"
# Persistent layout snapshot so a closed/crashed cockpit can be restored. MUST
# be outside /tmp to survive a reboot. Written throttled + only-on-change, now
# append-only into the SQLite store (lib.sh) so a save can never destroy the
# grid it is replacing — that is what made a dropped workspace unrecoverable.
SAVE_EVERY="${COCKPIT_SAVE_SECS:-5}"; next_save=0; last_snap=""
cockpit_layout_init

# State colour as a FORMAT directive (#[fg=…]) for the per-pane top line (@sc),
# NOT a pane-border-style: side-by-side panes share their vertical borders, so a
# per-pane border-style on a shared edge is ambiguous and flips on every redraw
# (the "all borders cycling" bug). The top status line is per-pane, so colouring
# it is unambiguous. Box borders stay a uniform neutral grey (set in apply_chrome).
# Each helper below sets the variable named in its comment rather than echoing:
# they run per pane per cycle, and every $(…) around them was a forked subshell.
color() { case "$1" in                       # → _COLOR
  working)      _COLOR='#[fg=colour41]';;      # green
  just-finished)_COLOR='#[fg=colour39,bold]';; # blue
  needs-input)  _COLOR='#[fg=colour196,bold]';;# red
  idle)         _COLOR='#[fg=colour245]';;     # dim
  *)            _COLOR='#[fg=colour245]';; esac; }

# compact duration so long idles roll over instead of reading "180m"/"2880m"
dur() { local s=$1                           # → _DUR
  if   (( s < 60 ));    then _DUR="${s}s"
  elif (( s < 3600 ));  then _DUR="$((s/60))m"
  elif (( s < 86400 )); then _DUR="$((s/3600))h"
  else                       _DUR="$((s/86400))d"; fi; }

badge() { dur "$2"                           # → _BADGE
  case "$1" in
    working)      _BADGE="⠿ working";;
    just-finished)_BADGE="✓ done $_DUR";;
    needs-input)  _BADGE="◉ NEEDS INPUT";;
    idle)         _BADGE="○ idle $_DUR";;
    *)            _BADGE="…";; esac; }

# attention priority for a workspace tab: needs-input > just-finished > working > idle
rank() { case "$1" in needs-input) _RANK=3;; just-finished) _RANK=2;; working) _RANK=1;; *) _RANK=0;; esac; }
worst() { local a; rank "$1"; a=$_RANK; rank "$2"   # → _WORST
  (( a >= _RANK )) && _WORST="$1" || _WORST="$2"; }
# colour the workspace NAME by its worst pane state (a #[fg=…] directive)
ws_color() { case "$1" in                    # → _WSCOLOR
  needs-input)  _WSCOLOR='#[fg=colour196,bold]';;
  just-finished)_WSCOLOR='#[fg=colour39,bold]';;
  working)      _WSCOLOR='#[fg=colour41]';;
  *)            _WSCOLOR='#[fg=colour245]';; esac; }

while $TMUX has-session -t "$COCKPIT_SESSION" 2>/dev/null; do
  # the pane/window the user is actually looking at
  ids=$($TMUX display -p -t "$COCKPIT_SESSION" '#{pane_id} #{window_id}' 2>/dev/null)
  active_pane="${ids% *}"; active_win="${ids#* }"
  # decide once per cycle whether titles are due for a refresh
  printf -v now '%(%s)T' -1; do_titles=0
  if (( now >= next_titles )); then do_titles=1; next_titles=$((now + TITLE_REFRESH)); fi
  if (( now >= next_resolve )); then
    next_resolve=$((now + RESOLVE_EVERY)); CLEAN=()
    roots=$(_CK_ROOTS=""; cockpit_project_roots)   # one claude-profile run per refresh, not one per pane
    [[ "$roots" == "$_CK_ROOTS" ]] || { _CK_ROOTS="$roots"; TPATH=(); }
  fi
  mapfile -t ROWS < <($TMUX list-panes -s -t "$COCKPIT_SESSION" -F "$PANE_FMT" 2>/dev/null)

  # One stat for every transcript already resolved. A path missing from STAT has
  # vanished (or is new) and is resolved and stat'ed on its own in the loop.
  STAT=()
  if (( ${#TPATH[@]} )); then
    while read -r m s p; do [[ -n "$p" ]] && STAT[$p]="$m $s"; done \
      < <(stat -c '%Y %s %n' -- "${TPATH[@]}" 2>/dev/null)
    # agy conversation dbs: the newer of db and -wal is the activity time (SQLite WAL leaves the db still)
    for p in "${TPATH[@]}"; do [[ "$p" == *.db && -n "${STAT[$p]:-}" ]] && STAT[$p]=$(agy_stat "$p"); done
  fi
  # Titles for every pane's session in one sqlite3 run (newlines and tabs flattened
  # in SQL so each row stays one line; ck_clean_label still normalises the rest).
  if (( do_titles )); then
    TITLE=(); idlist=""
    for row in "${ROWS[@]}"; do
      IFS="$TAB" read -r _ _ sid _ <<<"$row"
      [[ -n "$sid" && "$sid" != "$NIL" ]] && idlist+="${idlist:+,}'${sid//\'/\'\'}'"
    done
    if [[ -n "$idlist" ]]; then
      while IFS="$TAB" read -r id t; do [[ -n "$id" ]] && TITLE[$id]="$t"; done < <(sqlite3 -separator "$TAB" "$SANTA_DB" \
        "SELECT id, replace(replace(replace(coalesce(nullif(summary_title,''), substr(first_user_text,1,80), ''), \
           char(9), ' '), char(10), ' '), char(13), ' ') FROM sessions WHERE id IN ($idlist);" 2>/dev/null)
    fi
  fi

  # per-cycle, per-window tallies (workspaces = windows)
  declare -A WCOUNT=() WSTATE=()
  nA=0; nF=0; nI=0
  for row in "${ROWS[@]}"; do
    IFS="$TAB" read -r win pid sid cwd curlabel born agent hookstate hookat stateopt account <<<"$row"
    [[ -n "$win" ]] || continue
    [[ "$sid" == "$NIL" ]] && sid=""; [[ "$cwd" == "$NIL" ]] && cwd=""
    [[ "$curlabel" == "$NIL" ]] && curlabel=""; [[ "$born" == "$NIL" ]] && born=""
    [[ "$agent" == "$NIL" ]] && agent=""; [[ "$hookstate" == "$NIL" ]] && hookstate=""; [[ "$hookat" == "$NIL" ]] && hookat=""; [[ "$stateopt" == "$NIL" ]] && stateopt=""; [[ "$account" == "$NIL" ]] && account=""
    WCOUNT[$win]=$(( ${WCOUNT[$win]:-0} + 1 ))
    [[ "$agent" == claude || "$agent" == codex || "$agent" == agy ]] || continue
    if [[ -z "$sid" ]]; then
      # a pending NEW session (Alt-N): claim the transcript that appeared for this
      # pane's agent+cwd after it was born, then track it like any other.
      if [[ -n "$cwd" && -n "$born" ]]; then
        a=$(cockpit_adopt_agent "$agent" "$cwd" "$born" "$( $TMUX show -pqv -t "$pid" @account 2>/dev/null)")
        # The in-memory set prevents two pending panes claiming one rollout in this cycle; the tmux scan also
        # covers sessions that were already bound before this poller process started.
        if [[ -n "$a" && -z "${ADOPTED[$a]:-}" ]] &&
            ! $TMUX list-panes -a -F '#{@session_id}' | grep -Fxq "$a"; then
          ADOPTED[$a]=1; $TMUX set -p -t "$pid" @session_id "$a"; sid="$a"
        fi
      fi
      [[ -n "$sid" ]] || continue        # still pending, or a bare scratch shell — skip
    fi
    [[ -n "${LASTLABEL[$pid]:-}" ]] || LASTLABEL[$pid]="$curlabel"   # seed from what's on the border
    # Transcript location + last-write time are computed EVERY cycle, not only on
    # classify fallback: @activity_at (stamped below) makes "when did this pane
    # last actually produce anything" queryable, where before it survived only as
    # prose inside the badge string.
    tkey="$agent|$sid|$cwd|$account"; jsonl="${TPATH[$tkey]:-}"; st=""
    [[ -n "$jsonl" ]] && st="${STAT[$jsonl]:-}"
    if [[ -z "$st" ]]; then             # not resolved yet, or the cached file vanished
      jsonl=$(agent_transcript "$agent" "$sid" "$cwd")
      if [[ -n "$jsonl" && -f "$jsonl" ]]; then
        TPATH[$tkey]="$jsonl"
        if [[ "$agent" == agy ]]; then st=$(agy_stat "$jsonl"); else st=$(stat -c '%Y %s' -- "$jsonl" 2>/dev/null) || st=""; fi
      fi
    fi
    mtime="${st% *}"; size="${st#* }"; [[ -n "$st" ]] || { mtime=0; size=0; }
    # Event-driven state (cockpit-hook) is authoritative when fresh; otherwise
    # fall back to tail-parsing the transcript (pre-hook sessions, and any missed
    # edge once the hook state goes stale). Codex is a separate contract: its only
    # hook event is turn-complete → idle, so the stamp wins exactly while the
    # rollout hasn't moved past it — a stamp newer than the last transcript write
    # means the turn ENDED even when the last recorded boundary still says
    # task_started (the stuck-working-forever case), and a newer transcript write
    # means a new turn the hook cannot see, so classify wins. No TTL on the codex
    # idle stamp: idle stays idle until the rollout moves again.
    if [[ "$agent" == codex && "$hookstate" == idle ]] && (( mtime <= ${hookat:-0} )); then
      raw=idle; age=$(( now - ${hookat:-now} ))
    elif [[ "$agent" != codex && -n "$hookstate" ]] && (( now - ${hookat:-0} <= HOOK_TTL )); then
      raw="$hookstate"; age=$(( now - ${hookat:-now} ))
    elif [[ -z "$st" ]]; then
      raw=dead; age=$(( now - mtime ))   # agent_classify's verdict on a missing transcript
    else
      # agent_classify, minus the re-read when the transcript has not moved
      if [[ "${FACTKEY[$pid]:-}" != "$jsonl $st" ]]; then
        FACTS[$pid]=$(agent_facts "$agent" "$jsonl"); FACTKEY[$pid]="$jsonl $st"
      fi
      age=$(( now - mtime )); agent_state "$agent" "${FACTS[$pid]}" "$age"; raw="$CK_STATE"
    fi
    if [[ "${LASTACT[$pid]:-}" != "$mtime" ]]; then
      $TMUX set -p -t "$pid" @activity_at "$mtime"; LASTACT[$pid]="$mtime"
    fi

    state="$raw"
    # working -> idle edge = just-finished (your priority signal); sticky until visited
    if [[ "${PREV[$pid]:-}" == "working" && "$raw" == "idle" ]]; then FIN[$pid]=1; fi
    [[ "$raw" == "working" || "$raw" == "needs-input" ]] && FIN[$pid]=""   # woke back up
    [[ "$pid" == "$active_pane" ]] && FIN[$pid]=""                          # acknowledged by visiting
    [[ "${FIN[$pid]:-}" == "1" ]] && state=just-finished
    PREV[$pid]="$raw"

    # Only write when the value actually changes (re-setting still forces a
    # redraw). @sc tints this pane's top line; box borders are left uniform.
    color "$state"; nstyle="$_COLOR"
    if [[ "${LASTSTYLE[$pid]:-}" != "$nstyle" ]]; then
      $TMUX set -p -t "$pid" @sc "$nstyle"; LASTSTYLE[$pid]="$nstyle"
    fi
    badge "$state" "$age"; nbadge="$_BADGE"
    if [[ "${LASTBADGE[$pid]:-}" != "$nbadge" ]]; then
      $TMUX set -p -t "$pid" @badge "$nbadge"; LASTBADGE[$pid]="$nbadge"
    fi
    # @state is read by cockpit-next — but writing ANY pane option repaints that
    # pane's border line, so only write on change (else an idle pane's title
    # flickers every cycle).
    if [[ "${LASTSTATE[$pid]:-}" != "$state" || "$stateopt" != "$state" ]]; then
      $TMUX set -p -t "$pid" @state "$state"; LASTSTATE[$pid]="$state"
    fi

    # upgrade the title if santa has since produced a better one
    if (( do_titles )); then
      t="${TITLE[$sid]:-}"
      if [[ -n "$t" ]]; then        # first_user_text carries newlines/tabs — must be one line
        [[ -n "${CLEAN[$t]+set}" ]] || CLEAN[$t]=$(ck_clean_label "$t")
        t="${CLEAN[$t]}"
      fi
      if [[ -n "$t" && "$t" != "${LASTLABEL[$pid]:-}" ]]; then   # store full; border truncates
        $TMUX set -p -t "$pid" @label "$t"; LASTLABEL[$pid]="$t"
      fi
    fi

    # the workspace tab takes its colour from its worst (most-attention) pane,
    # but NOT from the window you're currently looking at (you've seen it).
    if [[ "$win" != "$active_win" ]]; then
      worst "${WSTATE[$win]:-idle}" "$state"; WSTATE[$win]="$_WORST"
    fi
    case "$state" in
      working|needs-input) nA=$((nA+1));; just-finished) nF=$((nF+1));; idle) nI=$((nI+1));;
    esac
  done

  # re-tile any window whose pane count changed; colour each workspace tab
  for win in "${!WCOUNT[@]}"; do
    if [[ "${PREV_WCOUNT[$win]:-}" != "${WCOUNT[$win]}" ]]; then
      $TMUX select-layout -t "$win" "${COCKPIT_LAYOUT:-even-horizontal}" 2>/dev/null
      PREV_WCOUNT[$win]="${WCOUNT[$win]}"
    fi
    ws_color "${WSTATE[$win]:-idle}"; nws="$_WSCOLOR"
    if [[ "${LASTWS[$win]:-}" != "$nws" ]]; then
      $TMUX set -w -t "$win" @ws_badge "$nws"; LASTWS[$win]="$nws"
    fi
  done

  if [[ "$nA/$nF/$nI" != "$prev_counts" ]]; then   # only touch the status bar on change
    $TMUX set -g @active_count "$nA"; $TMUX set -g @finished_count "$nF"; $TMUX set -g @idle_count "$nI"
    prev_counts="$nA/$nF/$nI"
  fi

  # persist the layout (throttled, only when it changed) so cockpit can restore it
  if (( now >= next_save )); then
    next_save=$((now + SAVE_EVERY))
    snap=$(cockpit_snapshot)
    if [[ -n "$snap" && "$snap" != "$last_snap" ]]; then
      cockpit_layout_save "$snap" && last_snap="$snap"
    fi
  fi
  sleep "$INTERVAL"
done
