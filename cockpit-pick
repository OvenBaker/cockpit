#!/usr/bin/env bash
# cockpit-pick — interactive chooser over dormant Claude sessions.
# Plain numbered selection on a real tty. Three uses:
#
#   cockpit-pick startup           multi-select in the launching terminal;
#                                  prints chosen  id<TAB>cwd<TAB>title  to stdout
#                                  (UI is written to /dev/tty so stdout is clean)
#   cockpit-pick retarget <pane>   single-select; respawn <pane> onto the choice
#   cockpit-pick add               single-select; split a fresh pane, respawn it
#
# Why a popup, not display-menu, and bound DIRECTLY (not via run-shell)?
# Popups/menus need a client to draw on; `run-shell` has none (it returns 1),
# so the launcher binds  display-popup -E "cockpit-pick …"  straight to the key.
# A popup is a real pty, so this same numbered prompt works there too — no fzf
# dependency, no press-and-hold mouse menu.
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"; source "$HERE/lib.sh"
TMUX=${COCKPIT_TMUX:-"tmux -L cockpit"}
POOL="${COCKPIT_POOL:-40}"             # how many candidates to list
DEF_N="${COCKPIT_DEFAULT_N:-6}"        # default selection count (startup, empty input)
MODE="${1:-startup}"

say() { printf '%s\n' "$*" >/dev/tty; }
pause() { read -rsn1 -p "$1" </dev/tty || true; say ""; }

fmt_age() { local s=$1
  (( s < 3600 ))  && { printf '%dm' $((s/60));    return; }
  (( s < 86400 )) && { printf '%dh' $((s/3600));  return; }
  printf '%dd' $((s/86400)); }

# expand a selection string ("1 3 5-8", "a"/"all", commas ok) into 1-based indices
parse_sel() {
  local raw="${1//,/ }" tok lo hi x
  if [[ "$raw" =~ ^[Aa]([Ll][Ll])?$ ]]; then seq 1 "${#CAND[@]}"; return; fi
  for tok in $raw; do
    if [[ "$tok" =~ ^([0-9]+)-([0-9]+)$ ]]; then
      lo=${BASH_REMATCH[1]}; hi=${BASH_REMATCH[2]}
      (( lo <= hi )) && for ((x=lo; x<=hi; x++)); do echo "$x"; done
    elif [[ "$tok" =~ ^[0-9]+$ ]]; then echo "$tok"; fi
  done
}

# respawn a pane onto a chosen session and re-stamp it so the poller tracks it
retarget_pane() {
  local pane="$1" id="$2" cwd="$3" title="$4" agent="${5:-claude}"
  if session_is_running_agent "$agent" "$id"; then   # re-check at action time
    say "cockpit: $id is live elsewhere — not retargeting"; sleep 1; return 0
  fi
  # Retargeting re-execs the provider in this pane. The pane's Claude account binding (@account) is a property
  # of the PANE the operator dedicated, not of the session it happens to hold, so it carries forward — with
  # its token re-applied to the new process. If it no longer resolves, refuse: retargeting onto the primary
  # account would move work to the wrong subscription with nothing on screen to say so.
  local acct tok; local -a eargs=()
  # `show -pv`, not `show -p | awk '{print $2}'`: an option cleared to "" prints as `@account ''`, so the awk
  # form yields the literal two-quote string and a CLEARED binding would read as a bound one.
  acct=$($TMUX show -pv -t "$pane" @account 2>/dev/null)
  if [[ -n "$acct" ]]; then
    if tok=$(cockpit_account_token "$acct" 2>/dev/null); then
      eargs=(-e "CLAUDE_CODE_OAUTH_TOKEN=$tok")
    else
      say "cockpit: pane is bound to Claude account '$acct', which no longer resolves — not retargeting"
      sleep 2; return 0
    fi
  fi
  local cmd; cmd=$(agent_resume_inner "$agent" "$id" "$cwd" "$title")
  $TMUX respawn-pane -k -t "$pane" "${eargs[@]}" "bash -lc $(printf %q "$cmd")"
  cockpit_stamp_known_agent "$pane" "$id" "$cwd" "$title" "$agent"
}

# spawn a brand-NEW session (no resume) in <cwd> for <agent>, reusing a bare
# shell if the active pane is one, else splitting. No @session_id — the poller
# adopts the transcript once the agent writes it (cockpit_adopt_agent), via @born.
spawn_new() {
  local W="$1" cwd="$2" agent="${3:-claude}" name="${4:-}" acct="${5:-}" cmd act actsid pane launch tok
  local -a eargs=()
  # An account is resolved BEFORE the pane exists: the token reaches the child through tmux's `-e` at exec,
  # so there is no stamping it on afterwards. A binding that does not resolve refuses the spawn outright
  # rather than quietly starting on the default account (an unset CLAUDE_CODE_OAUTH_TOKEN reads as "use the
  # primary"), which is the whole hazard this feature exists to avoid.
  if [[ -n "$acct" ]]; then
    [[ "$agent" == claude ]] || { say "  accounts are Claude-only — $agent has no CLAUDE_CODE_OAUTH_TOKEN equivalent."; return 1; }
    tok=$(cockpit_account_token "$acct" 2>/dev/null) \
      || { say "  account '$acct': $(cockpit_account_token "$acct" 2>&1 >/dev/null)"; return 1; }
    eargs=(-e "CLAUDE_CODE_OAUTH_TOKEN=$tok")
  fi
  case "$agent" in
    codex) launch="exec codex$(cockpit_codex_launch_args)";;
    shell) launch="exec bash -l";;
    *)     launch="exec claude$(cockpit_rc_args "$name" "$cwd")";;   # RC on: steerable from the app
  esac
  cmd="cd $(printf %q "$cwd") && $launch"
  act=$($TMUX display -p -t "$W" '#{pane_id}' 2>/dev/null)
  actsid=$($TMUX show -p -t "$act" @session_id 2>/dev/null | awk '{print $2}')
  if [[ -z "$actsid" && -n "$act" ]]; then
    pane="$act"
    # Stamp BEFORE respawning, not after. `respawn-pane -k` kills whatever occupies the pane, and if that
    # ever takes this process with it the two orders fail very differently: stamp-then-respawn can leave a
    # stamp whose token was not yet applied (restore reads the stamp and applies it — correct), while
    # respawn-then-stamp can leave a pane RUNNING on the second account with no stamp at all, which restore
    # silently returns to the primary. Fail towards the recoverable one.
    $TMUX set -p -t "$pane" @account "$acct"
    $TMUX respawn-pane -k -t "$pane" "${eargs[@]}" "bash -lc $(printf %q "$cmd")"
  else
    pane=$($TMUX split-window -t "$W" -P -F '#{pane_id}' "${eargs[@]}" "bash -lc $(printf %q "$cmd")" 2>/dev/null) \
      || { say "  no room for another pane at this width."; return 1; }
  fi
  # Stamp the NAME (never the token) so restore can rebuild this binding — and CLEAR it when there is no
  # account, because a stamp left standing on a reused pane would claim a binding whose token was never
  # applied: the display would say "second subscription" while the work billed the first, and restore
  # would then act on that false claim.
  $TMUX set -p -t "$pane" @account "$acct"
  if [[ "$agent" == shell ]]; then                 # plain terminal — not tracked
    $TMUX set -p -t "$pane" @session_id ""
    $TMUX set -p -t "$pane" @cwd "$cwd"
    $TMUX set -p -t "$pane" @agent "$agent"
    $TMUX set -p -t "$pane" @born ""               # no @born → poller won't try to adopt a transcript
    $TMUX set -p -t "$pane" @label "$(basename "$cwd") · bash"
    $TMUX set -p -t "$pane" @badge "shell"
  else                                             # claude/codex — poller adopts via @born
    cockpit_stamp_pending_agent "$pane" "$cwd" "new · $(basename "$cwd")" "$agent"
  fi
  $TMUX select-layout -t "$W" "$COCKPIT_LAYOUT" 2>/dev/null
}

# new-session mode runs before the dormant-session gather (it needs cwds, not sessions)
if [[ "$MODE" == new ]]; then
  W=$(cockpit_cur_window)
  # Three picker steps that only COLLECT. Nothing below touches tmux until the commit block at
  # the end, so cancelling — or an interrupted popup — leaves no half-made workspace or pane.
  wname=$($TMUX display -p -t "$W" '#{window_name}' 2>/dev/null)

  # --- step 1: agent (+ Claude account) --------------------------------------
  # Accounts are rows now, not numeric keys packed into one line of prose. The old menu grew a
  # segment per account ("Enter/1 = claude (default) · 2 = claude (work2) · c = codex · b = …")
  # and was already at the width of the popup with two accounts configured.
  broken=""
  while IFS=$'\t' read -r bad why; do broken+="${broken:+ · }$bad unavailable: $why"; done \
    < <(cockpit_accounts_broken)
  agentrows=$'claude\t\tClaude\tdefault account\n'
  while read -r a; do
    [[ -n "$a" ]] && agentrows+="claude"$'\t'"$a"$'\t'"Claude"$'\t'"account $a"$'\n'
  done < <(cockpit_accounts_list)
  agentrows+=$'codex\t\tCodex\tfresh codex session\n'
  agentrows+=$'shell\t\tBash shell\tplain terminal, not tracked'

  fargs=(); [[ -n "$broken" ]] && fargs=(--footer "$broken")
  sel=$(printf '%s\n' "$agentrows" | ck_select "New session · what?" \
          --hide 1,2 --match 3,4 "${fargs[@]}") || exit 0
  agent="${sel%%$'\t'*}"; rest="${sel#*$'\t'}"; acct="${rest%%$'\t'*}"
  what=$([[ "$agent" == shell ]] && echo "bash shell" || echo "$agent session")
  [[ -n "$acct" ]] && what="$what on account '$acct'"

  # --- step 2: directory -----------------------------------------------------
  # 200, not 15. Filtering makes a long list navigable, and the old 15-row window covered ~9% of
  # the directories santa has indexed — so the ordinary case was typing a full path blind, where
  # one typo closed the popup and discarded the agent choice.
  dirrows=""
  while IFS= read -r d; do dirrows+="$d"$'\t'"${d/#$HOME/\~}"$'\n'; done \
    < <(cockpit_recent_cwds 200)
  dirrows+="+type"$'\t'"type a path…"
  sel=$(printf '%s\n' "$dirrows" | ck_select "New $what · directory" --hide 1 --match 2) || exit 0
  target="${sel%%$'\t'*}"
  if [[ "$target" == "+type" ]]; then
    target=""
    # Re-prompt rather than exit: throwing away the agent choice over a mistyped path was the
    # sharpest edge in the old flow.
    for _ in 1 2 3; do
      printf '  path (~ ok · empty cancels): ' >/dev/tty
      read -r line </dev/tty || line=""
      [[ -n "${line// }" ]] || exit 0
      cand="${line/#\~/$HOME}"
      [[ -d "$cand" ]] && { target="$cand"; break; }
      say "  not a directory: $cand"
    done
    [[ -n "$target" ]] || { say "  no directory chosen."; sleep 0.6; exit 0; }
  fi

  # --- step 3: placement -----------------------------------------------------
  # Existing workspaces are selectable at last. Typing a name here used to be the ONLY way past
  # "this one", and tmux happily accepts a duplicate window name — so naming a workspace that
  # already existed silently built a second one beside it instead of targeting it.
  wsrows="+this"$'\t'"this workspace"$'\t'"${wname:-current}"$'\n'
  while IFS=$'\t' read -r wid wn wp; do
    [[ "$wid" == "$W" ]] && continue                     # already offered as "+this"
    wsrows+="$wid"$'\t'"$wn"$'\t'"$wp pane$( ((wp==1)) || echo s)"$'\n'
  done < <($TMUX list-windows -t "$COCKPIT_SESSION" -F '#{window_id}	#{window_name}	#{window_panes}')
  wsrows+="+new"$'\t'"+ new workspace…"$'\t'
  sel=$(printf '%s\n' "$wsrows" | ck_select "New $what · where?" --hide 1 --match 2) || exit 0
  dstw="${sel%%$'\t'*}"

  # --- commit ----------------------------------------------------------------
  placement="this workspace"
  case "$dstw" in
    +this) ;;
    +new)
      printf '  name for the new workspace: ' >/dev/tty
      read -r nm </dev/tty || nm=""
      nm="${nm#"${nm%%[![:space:]]*}"}"; nm="${nm%"${nm##*[![:space:]]}"}"   # trim
      [[ -n "$nm" ]] || exit 0
      W=$($TMUX new-window -t "$COCKPIT_SESSION" -P -F '#{window_id}' -n "$nm" "bash -l" 2>/dev/null) \
        || { say "  couldn't create workspace '$nm'."; sleep 1; exit 0; }
      placement="new workspace '$nm'"
      ;;
    *)
      W="$dstw"
      placement=$($TMUX display -p -t "$W" '#{window_name}' 2>/dev/null)
      ;;
  esac
  spawn_new "$W" "$target" "$agent" "" "$acct" \
    && $TMUX display-message "new $what in ${target/#$HOME/\~} · $placement"
  exit 0
fi

# --- gather + render ---------------------------------------------------------
mapfile -t CAND < <(cockpit_candidates "$POOL")
if (( ${#CAND[@]} == 0 )); then
  say "cockpit: no dormant sessions to choose from."
  [[ "$MODE" == startup ]] || pause "(any key to close) "
  exit 0
fi

say ""
say "  cockpit · dormant sessions  (cl=claude  cx=codex)"
say "  ┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄"
i=0
for row in "${CAND[@]}"; do
  IFS=$'\t' read -r id cwd title agent <<< "$row"; [[ -n "$agent" ]] || agent=claude
  i=$((i+1))
  jsonl=$(agent_transcript "$agent" "$id" "$cwd")
  age=$(fmt_age "$(idle_seconds "$jsonl")")
  tag=$([[ "$agent" == codex ]] && echo cx || echo cl)
  printf '  %2d  %s %4s  %-22s  %s\n' "$i" "$tag" "$age" "${cwd/#$HOME/\~}" "${title:0:44}" >/dev/tty
done
say ""

# --- act on the mode ---------------------------------------------------------
case "$MODE" in
  startup)
    n_def=$(( DEF_N < ${#CAND[@]} ? DEF_N : ${#CAND[@]} ))
    say "  Select panes to open:  e.g.  1 3 5-8   ·   a = all   ·   Enter = top $n_def"
    printf '  > ' >/dev/tty
    read -r line </dev/tty || line=""
    if [[ -z "${line// }" ]]; then mapfile -t idx < <(seq 1 "$n_def")
    else mapfile -t idx < <(parse_sel "$line"); fi
    declare -A seen
    for nsel in "${idx[@]}"; do
      (( nsel >= 1 && nsel <= ${#CAND[@]} )) || continue
      [[ -n "${seen[$nsel]:-}" ]] && continue; seen[$nsel]=1
      printf '%s\n' "${CAND[$((nsel-1))]}"          # → stdout, captured by launcher
    done
    ;;

  retarget)
    pane="${2:-}"
    # empty, or an unexpanded "#{pane_id}" → resolve the window's active pane
    # (unchanged by the keypress, so it's the pane the user pressed Alt-r on).
    [[ -z "$pane" || "$pane" == *'#{'* ]] && \
      pane=$($TMUX display -p -t "$COCKPIT_SESSION:0" '#{pane_id}' 2>/dev/null)
    say "  Retarget this pane → which session?"
    printf '  > ' >/dev/tty
    read -r line </dev/tty || line=""
    mapfile -t idx < <(parse_sel "$line"); nsel="${idx[0]:-}"
    [[ -n "$nsel" ]] && (( nsel >= 1 && nsel <= ${#CAND[@]} )) || { say "  cancelled."; sleep 0.6; exit 0; }
    IFS=$'\t' read -r id cwd title agent <<< "${CAND[$((nsel-1))]}"
    retarget_pane "$pane" "$id" "$cwd" "$title" "${agent:-claude}"
    say "  → ${title:0:50}"; sleep 0.6
    ;;

  add)
    W=$(cockpit_cur_window)   # add to the workspace you're viewing
    # If the active pane is a bare untracked shell (e.g. a freshly-created
    # workspace's placeholder), reuse it instead of splitting — otherwise split.
    act=$($TMUX display -p -t "$W" '#{pane_id}' 2>/dev/null)
    actsid=$($TMUX show -p -t "$act" @session_id 2>/dev/null | awk '{print $2}')
    split_made=0
    if [[ -z "$actsid" ]]; then
      pane="$act"                                            # reuse placeholder shell
    else
      pane=$($TMUX split-window -t "$W" -P -F '#{pane_id}' "bash -l" 2>/dev/null) \
        || { say "  no room for another pane at this width."; pause "(any key) "; exit 0; }
      split_made=1
      $TMUX select-layout -t "$W" "$COCKPIT_LAYOUT" 2>/dev/null
    fi
    say "  New pane → which session?"
    printf '  > ' >/dev/tty
    read -r line </dev/tty || line=""
    mapfile -t idx < <(parse_sel "$line"); nsel="${idx[0]:-}"
    if [[ -z "$nsel" ]] || ! (( nsel >= 1 && nsel <= ${#CAND[@]} )); then
      (( split_made )) && { $TMUX kill-pane -t "$pane" 2>/dev/null; $TMUX select-layout -t "$W" "$COCKPIT_LAYOUT" 2>/dev/null; }
      say "  cancelled."; sleep 0.6; exit 0      # reused placeholder is left as-is
    fi
    IFS=$'\t' read -r id cwd title agent <<< "${CAND[$((nsel-1))]}"
    retarget_pane "$pane" "$id" "$cwd" "$title" "${agent:-claude}"
    say "  → ${title:0:50}"; sleep 0.6
    ;;

  *) echo "usage: cockpit-pick {startup|retarget <pane>|add|new}" >&2; exit 2;;
esac
