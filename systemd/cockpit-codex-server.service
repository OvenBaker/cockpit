[Unit]
Description=Shared Codex backend for cockpit and Windows mobile control
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=%h/tools/cockpit/cockpit-codex-server
Environment=LOG_FORMAT=json
Environment=RUST_LOG=warn
Restart=always
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=default.target
