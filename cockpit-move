#!/usr/bin/env bash
# cockpit-move — move the active pane to another workspace (window). Per-pane
# stamps (@session_id, @label, …) travel with the pane, so the poller keeps
# tracking it; we just re-tile the source and destination. Moving the last pane
# out of a workspace empties it, and tmux closes the empty window.
#
#   cockpit-move next | prev      shove the active pane to the adjacent workspace
#   cockpit-move pick [src]       popup: choose an existing workspace, or make one
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"; source "$HERE/lib.sh"
TMUX=${COCKPIT_TMUX:-"tmux -L cockpit"}

retile() { $TMUX select-layout -t "$1" "$COCKPIT_LAYOUT" 2>/dev/null || true; }

# join <src-pane> into <dst-window>, then re-even both windows. -d keeps focus
# from following the pane, and we re-select the source window so you stay put
# (unless it emptied and tmux closed it).
move_to() {
  local src="$1" dst="$2" srcwin
  srcwin=$($TMUX display -p -t "$src" '#{window_id}')
  [[ "$srcwin" == "$dst" ]] && return 1            # already there
  $TMUX join-pane -d -s "$src" -t "$dst" 2>/dev/null || return 1
  retile "$dst"; retile "$srcwin"                  # srcwin may have closed; harmless
  $TMUX select-window -t "$srcwin" 2>/dev/null || true
}

case "${1:-pick}" in
  next|prev)
    src=$($TMUX display -p -t "$COCKPIT_SESSION" '#{pane_id}')
    srcwin=$($TMUX display -p -t "$COCKPIT_SESSION" '#{window_id}')
    mapfile -t order < <($TMUX list-windows -t "$COCKPIT_SESSION" -F '#{window_id}')
    (( ${#order[@]} >= 2 )) || { $TMUX display-message "cockpit: only one workspace — Alt-m to make another"; exit 0; }
    idx=-1; for i in "${!order[@]}"; do [[ "${order[$i]}" == "$srcwin" ]] && idx=$i; done
    if [[ "$1" == next ]]; then j=$(( (idx + 1) % ${#order[@]} ))
    else j=$(( (idx - 1 + ${#order[@]}) % ${#order[@]} )); fi
    dst="${order[$j]}"; dstname=$($TMUX display -p -t "$dst" '#{window_name}')
    move_to "$src" "$dst" && $TMUX display-message "moved pane → $dstname"
    ;;

  pick)
    src="${2:-}"
    [[ -z "$src" || "$src" == *'#{'* ]] && src=$($TMUX display -p -t "$COCKPIT_SESSION" '#{pane_id}')
    srcwin=$($TMUX display -p -t "$src" '#{window_id}' 2>/dev/null)
    srcname=$($TMUX display -p -t "$srcwin" '#{window_name}' 2>/dev/null)
    srcidx=$($TMUX display -p -t "$src" '#{pane_index}' 2>/dev/null)
    say() { printf '%s\n' "$*" >/dev/tty; }

    # Prefer a copy beside the scripts (a pinned deploy dir), else PATH. Failing loudly beats
    # keeping a second, divergent numbered-prompt UI alive as a fallback.
    SELECT="${COCKPIT_SELECT:-$HERE/cockpit-select}"
    [[ -x "$SELECT" ]] || SELECT=$(command -v cockpit-select 2>/dev/null || true)
    [[ -n "$SELECT" ]] || {
      say "  cockpit-select not found on PATH or in $HERE."
      say "  build it:  go build -o ~/.local/bin/cockpit-select ./cmd/cockpit-select"
      read -rsn1 -p "  (any key to close) " </dev/tty || true; exit 0; }

    # Rows are built HERE and merely chosen THERE: cockpit-select gets no pane id and issues no
    # tmux call, so the join-pane/break-pane below stays the single mutation for this action.
    # The source window is dropped from the list rather than rejected after you pick it.
    rows=$($TMUX list-windows -t "$COCKPIT_SESSION" \
             -F '#{window_id}	#{window_name}	#{window_panes}' \
           | awk -F'\t' -v skip="$srcwin" 'BEGIN{OFS="\t"}
               $1==skip {next}
               {print $1, $2, $3 " pane" ($3==1 ? "" : "s")}')
    rows+=$'\n''+new'$'\t''+ new workspace…'$'\t'

    # --match 2 keeps the filter on workspace names. Without it "a" matches every row, because
    # the decorative "N panes" column contains one.
    sel=$(printf '%s\n' "$rows" | "$SELECT" \
            --title "Move pane ${srcidx:-?} · ${srcname:-?} → workspace" \
            --hide 1 --match 2) || exit 0     # non-zero = cancelled; nothing was touched

    dst="${sel%%$'\t'*}"
    if [[ "$dst" == "+new" ]]; then
      printf '  name for the new workspace: ' >/dev/tty; read -r nm </dev/tty || nm=""
      [[ -n "${nm// }" ]] || exit 0
      $TMUX break-pane -d -s "$src" -n "$nm" 2>/dev/null \
        && { retile "$srcwin"; $TMUX display-message "moved pane → new workspace '$nm'"; }
    else
      # Feedback goes to the status line, not a held-open popup: the popup closes the instant
      # the choice is made, which is what removes the old fixed `sleep`s.
      dstname=$($TMUX display -p -t "$dst" '#{window_name}' 2>/dev/null)
      move_to "$src" "$dst" && $TMUX display-message "moved pane → $dstname"
    fi
    ;;

  *) echo "usage: cockpit-move {next|prev|pick [src]}" >&2; exit 2;;
esac
